# Settings for docker-compose.ingress.yml — the shared edge.
#
# One copy for the whole box, never in git:
#
#   /opt/rental/ingress.env
#
# Unlike the app environments, this one is brought up once at provision time and
# changed only when a domain changes.

# The mailbox Let's Encrypt uses for expiry and revocation warnings. It must be
# one somebody reads: the first notice usually arrives because renewal is
# already failing.
ACME_EMAIL=

# Site addresses.
#
# A bare hostname makes Caddy obtain and renew a certificate automatically:
#
#   PRODUCTION_SITE_ADDRESS=app.example.com
#   STAGING_SITE_ADDRESS=staging.example.com
#
# An `http://` prefix disables TLS for that site. Correct for a local rehearsal,
# never correct on a public box:
#
#   PRODUCTION_SITE_ADDRESS=http://production.localhost
#   STAGING_SITE_ADDRESS=http://localhost
#
# Both must be set even if only one environment is running. Caddy routes on the
# Host header, so the unused one simply returns 502 until its stack exists.
PRODUCTION_SITE_ADDRESS=
STAGING_SITE_ADDRESS=
