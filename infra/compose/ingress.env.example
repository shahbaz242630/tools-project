# Settings for docker-compose.ingress.yml — the shared edge.
#
# One copy for the whole box, never in git:
#
#   /opt/rental/ingress.env
#
# Unlike the app environments, this one is brought up once at provision time and
# changed only when a domain changes.

# The mailbox Let's Encrypt uses for expiry and revocation warnings. It must be
# one somebody reads: the first notice usually arrives because renewal is
# already failing.
#
# **Currently inert, and kept anyway.** Behind Cloudflare's Tunnel, TLS
# terminates at Cloudflare and Caddy never requests a certificate, so nothing
# reads this. It stays because it is required the moment the edge ever serves
# TLS itself, and a variable removed and re-added is a variable somebody sets to
# a placeholder.
ACME_EMAIL=

# Site addresses.
#
# **Behind the Tunnel, the `http://` form is the correct one on a public box.**
# That reverses the advice this file used to give. Cloudflare terminates TLS at
# its edge and `cloudflared` carries the request inward over the Docker network,
# so a bare hostname here would make Caddy attempt ACME for a name that resolves
# to Cloudflare rather than to us — which fails, repeatedly, and can exhaust
# Let's Encrypt's five-per-week limit on the way.
#
#   PRODUCTION_SITE_ADDRESS=http://app.example.com
#   STAGING_SITE_ADDRESS=http://staging.example.com
#
# The same form is what a local rehearsal wants, for a different reason — there
# is no public DNS record for `localhost` and ACME could never succeed:
#
#   PRODUCTION_SITE_ADDRESS=http://production.localhost
#   STAGING_SITE_ADDRESS=http://localhost
#
# Both must be set even if only one environment is running. Caddy routes on the
# Host header, so the unused one simply returns 502 until its stack exists.
PRODUCTION_SITE_ADDRESS=
STAGING_SITE_ADDRESS=

# The Cloudflare Tunnel's credentials, from the tunnel's own page in Zero Trust.
#
# **Secret, and it is the whole of the tunnel's identity** — anyone holding it
# can serve traffic as these hostnames. Treat it like a private key: it belongs
# in this file (mode 600) and nowhere else, never in git and never in a shell
# command that lands in history.
#
# Only read when the stack is started with `--profile tunnel`, which is what the
# box does and the CI rehearsal deliberately does not.
CLOUDFLARE_TUNNEL_TOKEN=

# Which interface Caddy's port 80 is published on.
#
# **Leave it unset.** The default is `127.0.0.1`, and that default is how BRD
# §10.2 is met: `cloudflared` reaches Caddy by container name on the `edge`
# network, so nothing needs the published port and nothing outside the box can
# dial it. Setting this to `0.0.0.0` puts plain HTTP on a public IP, which is
# precisely what §10.2 forbids and what kept this stack switched off for a month.
#
# It exists so the CI rehearsal can curl the edge from the runner, and so a
# future topology that genuinely fronts the box differently has a way in that is
# a deliberate act rather than an accident.
# INGRESS_BIND_ADDRESS=127.0.0.1
