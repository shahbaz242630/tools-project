# Per-environment settings for docker-compose.app.yml.
#
# One copy per environment on the box, never in git:
#
#   /opt/rental/staging.env
#   /opt/rental/production.env
#
# Both must be `chmod 600` and owned by the deploy user. They hold the only copy
# of the database password — this file holds none, deliberately.
#
# Every variable below is required. The compose file uses `${VAR:?}` rather than
# defaults so a missing one stops the deploy with a named error, instead of
# starting the stack with an empty credential.

# --- Identity ----------------------------------------------------------------
# `staging` or `production`. Decides the compose project name, the container
# names and which volumes are used, so getting it wrong points one environment
# at the other's database.
APP_ENV=staging

# --- Image -------------------------------------------------------------------
# Where the Release workflow publishes to. The `/api` and `/worker` suffixes are
# appended by the compose file.
IMAGE_REPOSITORY=ghcr.io/shahbaz242630/tools-project

# The commit SHA to run. Do not set this by hand — `scripts/deploy.mjs` writes
# it, records the previous value, and can put it back. Editing it here and
# running `docker compose up` yourself skips the health check and leaves the
# rollback history wrong.
IMAGE_TAG=

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=info

# --- Database (managed, on Neon — ADR 0037) -----------------------------------
# The database is NOT in the compose stack. It runs on Neon, which is what
# discharges ADR 0009's requirement that durability live off the box.
#
# **Two hosts, and they are not interchangeable.** Neon publishes a pooled
# endpoint and a direct one, differing by the six characters `-pooler`:
#
#   POSTGRES_HOST         the -pooler endpoint. The API and the worker hold
#                         long-lived connections through it; the direct endpoint
#                         has a far lower connection ceiling.
#   POSTGRES_DIRECT_HOST  the same host WITHOUT -pooler. Migrations only.
#                         Prisma takes a Postgres advisory lock so two deploys
#                         cannot migrate at once, and advisory locks are session
#                         state — a transaction pooler hands out a different
#                         backend per transaction, so through the pooler the
#                         lock is taken and instantly lost, and `migrate deploy`
#                         either hangs or races.
#
# Copy both from the Neon console: Connect, with pooling on and then off.
POSTGRES_HOST=ep-example-12345678-pooler.c-5.eu-central-1.aws.neon.tech
POSTGRES_DIRECT_HOST=ep-example-12345678.c-5.eu-central-1.aws.neon.tech
POSTGRES_PORT=5432

# Neon's own role and database names, not ours to choose. `neondb_owner` and
# `neondb` are what a new project is created with.
POSTGRES_USER=neondb_owner
POSTGRES_DB=neondb

# Leave empty here. **Not generated by us** — Neon issues it, and the console
# is the only place it can be read. Copy it from Connect, or reset it there.
#
# Staging and production are separate Neon projects with separate credentials.
# Reusing one across both means a staging deploy migrating production.
POSTGRES_PASSWORD=

# How the database connection is protected (ADR 0038).
#
# `verify-full` — encrypted, with the certificate chain and the hostname both
# checked — is the value for any database reached over a network we do not own,
# which from ADR 0037 means Neon. Set `disable` only if Postgres is genuinely a
# container on this box's private network, and set it deliberately: the API
# refuses to start with this unset under NODE_ENV=production, rather than
# quietly connecting in the clear.
#
# Only three values are accepted: disable, no-verify, verify-full. `require` is
# refused on purpose — pg 8 reads it as an alias for verify-full and pg 9 reads
# it as encrypted-but-unverified, so it is the one value that silently weakens
# when a dependency is bumped.
#
# **Note what you are about to be handed.** Neon's console gives you a string
# ending `?sslmode=require&channel_binding=require`. Do not copy that value in
# here — it is the one this project refuses, and `verify-full` was confirmed
# working against Neon on both endpoints on 9 August 2026.
POSTGRES_SSLMODE=verify-full

# --- Identity: Clerk (ADR 0015) ----------------------------------------------
# Identity lives at Clerk; `users` in our database is a mirror keyed by our own
# id. Two of the four values below are secrets and belong only in this file on
# the box, chmod 600.
#
# Staging and production must use *different Clerk instances*. A shared instance
# means a staging sign-up creates a production account, and a staging webhook
# rewrites a production user's email.

# Public — compiled into the browser bundle. Not a secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# SECRET. Clerk's Next SDK uses it server-side for the session handshake. It can
# read and modify the entire user directory. Leave empty here; fill in on the box.
CLERK_SECRET_KEY=

# SECRET. Verifies webhook signatures. The webhook is the only external writer
# of the identity mirror, so forging one means creating and modifying accounts.
# Minted when you create the endpoint in the Clerk dashboard, pointing at
# https://<this environment's host>/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# Public — Clerk publishes it at the instance's JWKS endpoint. The API verifies
# session signatures against it and is given nothing else, so an API that is
# compromised yields a key anyone can already fetch rather than the ability to
# mint sessions or impersonate. PEM on one line with \n escaped; see .env.example
# at the repository root for the one-liner that derives it.
CLERK_JWT_PUBLIC_KEY=

# Origins whose tokens the API accepts, as the `azp` claim. The public URL of
# *this* environment's web app, e.g. https://staging.example.co.uk
CLERK_AUTHORIZED_PARTIES=

# SECRET, and unlike everything else here it is NOT RECOVERABLE.
# Encrypts the street lines of stored addresses (ADR 0016). Generate with
# `openssl rand -base64 32`.
#
# Losing it makes every stored address unreadable, including in backups —
# so it belongs in the backup plan and must be kept somewhere that survives
# losing the database, and separate from it. Staging and production must
# use different keys: a shared one means a staging dump decrypts production
# addresses. The API holds it; the worker deliberately does not.
PERSONAL_DATA_ENCRYPTION_KEY=

# Collect and expose metrics on the API's /metrics (slice H1). Defaults to true
# when absent. The endpoint carries no credential and needs none: the API is not
# reachable from the internet, and Prometheus scrapes it over the internal
# network from inside the stack.
METRICS_ENABLED=true

# Grafana's admin password. Only needed if you bring up the observability stack.
#
# There is no default and the container refuses to start without one, which is
# deliberate: `admin`/`admin` on a dashboard showing the shape of the whole
# system is the single most common way self-hosted monitoring becomes somebody
# else's way in. Grafana is bound to 127.0.0.1 and reached over an SSH tunnel,
# so this is a second lock rather than the only one.
GRAFANA_ADMIN_PASSWORD=
