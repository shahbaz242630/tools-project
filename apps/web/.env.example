# Copy to .env.local and fill in. Never commit .env.local — this repo is public.
#
# Named .env.example rather than .env.local.example because .gitignore ignores
# .env.* and negates only !.env.example — the more obvious name is silently
# untracked, which for a file whose whole job is to document the required set
# is the worst possible failure.
#
# The web app's own environment. Next reads .env.local from this directory; the
# repository-root .env is the API's and the worker's. They are separate on
# purpose: the web app is the only process a browser can reach, so it holds no
# database credentials at all (see packages/config/src/web-env.ts).
#
# Most of this file is written for you by `clerk init`. It is checked in as an
# example so the required set is visible without running anything.

# Where the API lives, as seen from the web *server* process. Inside the compose
# network that is http://api:3000; locally the API runs on 3001, because the
# Next dev server takes 3000.
#
# Deliberately not NEXT_PUBLIC_: that prefix inlines a value into the browser
# bundle, and the internal address of the API is not something to publish.
API_BASE_URL=http://localhost:3001

# --- Clerk (ADR 0015) --------------------------------------------------------
# Pull the first two with `clerk env pull --file .env.local`.

# Public by design — this one is compiled into the browser bundle, which is what
# the NEXT_PUBLIC_ prefix means.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret, server-side only. Clerk's Next SDK needs it for the session handshake.
#
# This is the one genuinely sensitive value the web app holds, and it is a real
# cost of choosing a hosted identity provider: the internet-facing service now
# has a key that can read the whole user directory. It stops here — the API is
# given only the public JWT key. See ADR 0015.
CLERK_SECRET_KEY=

# Secret. Verifies the Standard Webhooks signature on Clerk deliveries.
#
# Here rather than with the API because the delivery arrives at the web app —
# the only service on the edge network — and verification needs the raw unparsed
# body, which exists there and nowhere downstream.
#
# Not derivable: create a webhook endpoint in the Clerk dashboard pointing at
# https://<your-host>/api/webhooks/clerk and copy the signing secret it mints.
# For local development, `clerk webhooks listen --forward-to
# http://localhost:3000/api/webhooks/clerk` relays deliveries to this machine.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Clerk routing -----------------------------------------------------------
# Written by `clerk init`. They tell Clerk's components where the hosted
# sign-in and sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
