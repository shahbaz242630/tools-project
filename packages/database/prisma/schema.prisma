// The database schema. Migrations in ./migrations are the source of truth for
// what is actually deployed; this file describes the shape they build up to.
//
// Prisma 7 notes, all of which differ from most documentation still in
// circulation (see ADR 0014):
//   - `url` is not permitted here. Connection settings live in prisma.config.ts.
//   - The client requires a driver adapter; ours is @prisma/adapter-pg.
//   - The generator emits TypeScript source, not compiled JavaScript.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// Platform roles.
///
/// Coarse by design. Ownership — "is this your listing, your booking" — is a
/// row-level question answered by the data, not by a role, and conflating the
/// two produces roles like `OWNER` that multiply per entity. BRD §6 gives one
/// account both renter and owner capabilities, so neither is a role here.
enum UserRole {
  USER
  ADMIN
}

/// A platform account.
///
/// The internal `id` is the authoritative platform identity (BRD §6). Identity
/// and payment provider IDs are stored as references against it in later
/// phases, never as the primary key — a provider that deletes an account, or
/// that we stop using, must not take the identity with it.
///
/// Since ADR 0015 this row is a **mirror**: Clerk holds the credentials and is
/// the source of truth for the identity, while this row is the thing listings,
/// bookings, messages and the ledger point at. That split is the entire reason
/// `clerkUserId` is an ordinary column and not the primary key.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Clerk's `user_…` identifier. A reference, never an identity — see the note
  /// above. Unique because two platform accounts mirroring one Clerk user would
  /// make "who is this request" ambiguous at exactly the point it must not be.
  clerkUserId String @unique @db.Text

  /// citext, so `Alice@Example.com` and `alice@example.com` are one account.
  /// Case folding in application code would leave the database able to hold
  /// both, and the uniqueness guarantee has to be the database's.
  ///
  /// Mirrored from Clerk's primary email address. On deletion it is replaced
  /// with a tombstone rather than kept — see `deletedAt`.
  email String @unique @db.Citext

  role UserRole @default(USER)

  /// Soft deletion, because hard deletion is not available to us: from Phase 2
  /// onward listings, bookings and immutable ledger entries reference this row,
  /// and the ledger in particular can never lose its counterparty.
  ///
  /// When Clerk reports a user deleted we set this *and* overwrite `email` with
  /// a tombstone at `.invalid` (RFC 2606, so it can never collide with a real
  /// address). That frees the address for genuine re-registration, which a
  /// retained unique row would otherwise block forever, and it removes the
  /// personal data we no longer have a purpose for. Full erasure semantics are
  /// a later slice — BRD §14 Phase 1 asks only for a deletion *skeleton*.
  deletedAt DateTime? @db.Timestamptz(3)

  /// When the person asked to be deleted, as distinct from when we acted on it.
  ///
  /// Two columns rather than one because they answer different questions and
  /// will diverge. `deletedAt` is the state the guard checks; this is the
  /// *request*, which is what a data-protection enquiry asks about — "when did
  /// they ask, and how long did you take". They are set together today because
  /// there is no grace period; a later slice that adds one would leave this set
  /// and `deletedAt` null for the duration, and nothing above has to change.
  deletionRequestedAt DateTime? @db.Timestamptz(3)

  /// When the account was suspended, or null if it is not.
  ///
  /// **Distinct from deletion in every way that matters.** Deletion is the
  /// person's own request and erases their data (ADR 0018); suspension is done
  /// *to* them by an administrator, is reversible, and destroys nothing. A
  /// suspended account can still sign in — it must, because UK GDPR access and
  /// erasure rights do not lapse because somebody was suspended, and an account
  /// that cannot authenticate cannot exercise them (ADR 0024).
  ///
  /// BRD §5.1 gives suspension to Trust & Safety, which does not exist yet.
  /// This is the mechanism that module will eventually drive; §14 Phase 1 asks
  /// for the skeleton and the policy comes later.
  suspendedAt DateTime? @db.Timestamptz(3)

  /// Which administrator did it.
  ///
  /// ON DELETE SET NULL rather than RESTRICT: losing who suspended somebody is
  /// bad, but the audit trail holds that permanently and it must not be
  /// possible for an old suspension to block an account removal. The same
  /// trade the audit log's actor makes.
  suspendedById String? @db.Uuid
  suspendedBy   User?   @relation("SuspendedAccounts", fields: [suspendedById], references: [id])

  /// Why, in the administrator's own words.
  ///
  /// **Shown to the suspended person**, which is deliberate and is the same
  /// bargain ADR 0021 struck for administrative reads: an administrator writing
  /// a reason knows who will read it, and that is what makes it a real control
  /// rather than a box to clear. It also means a suspension reason must be
  /// something you would be willing to say to the person's face, which is the
  /// right constraint on it.
  suspensionReason String? @db.Text

  /// Accounts this administrator suspended. Declared because Prisma requires
  /// both ends of a relation, not so anything reads suspensions through a user.
  suspendedAccounts User[] @relation("SuspendedAccounts")

  /// Stored UTC. Rendering and rental-period arithmetic happen in the booking's
  /// stored IANA timezone (BRD §6.1), never in the database.
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Present only because Prisma requires both ends of a relation to be
  /// declared. **Not** an invitation for the identity module to read through
  /// them: BRD §5.1 gives public profiles to Profiles & Trust, and
  /// `include: { profile: true }` from inside `identity/` is exactly the
  /// cross-module read that boundary exists to prevent. The profiles module
  /// reaches its own rows through its own port.
  profile Profile?
  address Address?

  /// Audit entries this account was the actor of. Same caveat as above — the
  /// relation exists because Prisma requires both ends declared, not so that
  /// another module can read the log through a user.
  auditEntries AuditLog[]

  /// The three sides of an administrative approval this account took part in.
  ///
  /// Three named relations because Prisma cannot tell them apart otherwise, not
  /// because anything reads an approval through a user. The distinction that
  /// matters is enforced in the database rather than here: a CHECK constraint
  /// stops `approvedById` ever equalling `proposedById`.
  proposedApprovals  AdminApproval[] @relation("ProposedApprovals")
  grantedApprovals   AdminApproval[] @relation("GrantedApprovals")
  cancelledApprovals AdminApproval[] @relation("CancelledApprovals")

  /// Sign-ins and sign-outs on this account. Declared because Prisma requires
  /// both ends of a relation; nothing reads authentication events through a
  /// user, and the identity module reaches them through its own port.
  authenticationEvents AuthenticationEvent[]

  /// Category configurations this account authored. BRD §6.2 puts an author on
  /// every category version, and this is that reference. Declared because
  /// Prisma requires both ends; the Catalogue module reaches versions through
  /// its own port and never through a user.
  authoredCategoryVersions CategoryVersion[]

  /// Present and inactive — see `SellerTaxProfile`. Optional because no seller
  /// has one and none can until a category is flagged reportable (§8.14.2).
  sellerTaxProfile SellerTaxProfile?

  /// What this person has put up for rent. `ON DELETE RESTRICT` — see `Listing`.
  listings Listing[]

  /// What this person has rented, or asked to (BRD §7, slice 4.2).
  ///
  /// **`ON DELETE RESTRICT`, and here that is load-bearing rather than a
  /// default.** Accounts are soft-deleted with a tombstoned email precisely so
  /// that a counterparty can never be lost — a renter's history has to keep
  /// naming who they rented from, and the other side's history has to keep
  /// naming them. A cascade from this relation would erase one party's record
  /// of a transaction because the *other* party asked to leave.
  bookings Booking[]

  /// Prices this person has been quoted (BRD §8.5.2, slice 4.4b).
  ///
  /// **`ON DELETE RESTRICT` from 4.5a, where it was `CASCADE` in 4.4b** — a quote
  /// a booking was made from carries terms the counterparty is entitled to, and
  /// accounts are soft-deleted so this never fires in the ordinary course.
  /// Erasure is QuotesService.eraseFor, which deletes the quotes nothing has
  /// booked; the constraint is what turns a mistake there into a failed delete
  /// rather than a destroyed record.
  quotes Quote[]

  /// Booking events this person caused (slice 4.5a). Declared because Prisma
  /// requires both ends; a booking's history is read through the booking, never
  /// through an actor. Most events have no actor at all — an expiry sweep and an
  /// auto-decline are the platform's own doing.
  bookingEvents BookingEvent[]

  /// Listings this administrator has moderated (ADR 0041). Declared because
  /// Prisma requires both ends of a relation; nothing reads a moderator's
  /// listings *through the user*, and if something ever needs to — "show me
  /// everything this moderator decided" — that is a Phase 9 report and belongs
  /// behind a port, not on this model.
  moderatedListings Listing[] @relation("ListingModerator")

  /// Feature flags this account last switched. Declared because Prisma requires
  /// both ends; the feature-flags module reaches overrides through its own port
  /// and never through a user.
  changedFeatureFlags FeatureFlagOverride[]

  /// This person's ledger accounts (slice 5.1). Declared because Prisma requires
  /// both ends; the payments module reaches an account through its own port and
  /// never through a user. **The relation is `RESTRICT` at the other end on
  /// purpose** — ADR 0015 soft-deletes an account so the ledger can never lose a
  /// counterparty, and this is the reference that was being anticipated.
  ledgerAccounts LedgerAccount[]

  /// Attempts to pay this person for a hire (slice 5.2b). Declared for the same
  /// reason and read the same way: never through a user.
  paymentIntents PaymentIntent[]

  @@map("users")
}

/// A person's public face, and the contact details behind it.
///
/// A separate table rather than columns on `users`, because BRD §5.1 draws the
/// boundary there: Identity & Access owns accounts, roles and sessions, and
/// Profiles & Trust owns public profiles. Two modules writing one table is the
/// cross-module write CLAUDE.md bans, and it would be unavoidable if the
/// display name lived beside `role` and `deletedAt`.
///
/// **Only `displayName` is public.** BRD §6.2 calls this the "public and
/// contact profile" — one row, two audiences — so the split is enforced by the
/// projection the API returns, not by which table a column sits in. ADR 0016
/// records the rule: a stranger sees a name and a postal district, and contact
/// details are released only once a booking authorises it, the same way BRD
/// §8.4.1 gates a listing's true coordinates.
model Profile {
  id String @id @default(uuid()) @db.Uuid

  /// One profile per account. Unique because the alternative — two profiles for
  /// one user — makes "what is this person called" a question with two answers,
  /// and the loser is whichever row a query happens to sort first.
  ///
  /// `onDelete: Restrict` is the Prisma default for a required relation and is
  /// correct here: accounts are soft-deleted (see `User.deletedAt`), so a hard
  /// delete reaching this constraint means something is doing what the identity
  /// module deliberately does not. Failing is the right answer to that. Erasing
  /// a profile as part of a real deletion request is a later, deliberate slice.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// What other users see. NOT NULL because the row is created by the first
  /// save rather than provisioned empty — there is no state in which a profile
  /// exists without a name, so nothing downstream has to handle one.
  ///
  /// Deliberately **not** unique. Uniqueness would invite name squatting and a
  /// registration race, and it does not solve impersonation anyway: "Support"
  /// and "Support " are different strings. Impersonation is a Trust & Safety
  /// question for a later phase, not a constraint this column can answer.
  displayName String @db.Text

  /// Contact number, in E.164. **Never returned by a public endpoint.**
  ///
  /// Nullable because BRD §8.1 requires a verified phone before *listing or
  /// booking*, not before having a profile — demanding one at sign-up would
  /// block someone who only wants to browse.
  ///
  /// Stored in clear rather than encrypted, unlike the address detail. It is
  /// the same sensitivity class as `users.email`, which must be readable for
  /// citext uniqueness, and encrypting it would defeat the duplicate-number
  /// check that Trust & Safety needs against multi-account fraud. The
  /// protection here is that no projection exposes it, and that is tested.
  ///
  /// **Unverified.** Nothing has proved this number belongs to this person yet;
  /// verification needs Twilio (Phase 6) or a Clerk phone flow. Until then it
  /// must not be treated as a trust signal.
  phone String? @db.Text

  /// Whether this person lists as themselves or as a business — BRD §8.3's
  /// consumer-law disclosure (slice 2.13, ADR 0043).
  ///
  /// `private_owner` or `professional_trader`, and **NULL until they answer**.
  /// No default, because the likely answer being the default is precisely what
  /// would make it wrong rarely and silently — the platform would be answering
  /// a legal question on somebody's behalf. Publication refuses a listing whose
  /// owner has not answered.
  ///
  /// **On the person, not the listing.** §8.3's wording puts it on the listing
  /// and ADR 0043 corrects that: it is a fact about who somebody is, and
  /// per-listing would let one owner's adverts contradict each other about their
  /// own legal capacity. Every marketplace holds it at the account.
  ///
  /// **Not `seller_tax_profiles`**, which answers HMRC's question about which
  /// regime a return is filed under. A trader can be non-reportable and a
  /// reportable seller can be private.
  ///
  /// `CHECK`ed in the database as well as in code (`owner_status_is_known`),
  /// unlike `listings.status`. The value carries a legal meaning, so a row
  /// written by a fixture script or a hand-edit that this build cannot interpret
  /// would have a public page state something untrue about somebody's capacity.
  ownerStatus String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

/// A postal address, split by how far each part may travel.
///
/// Its own table rather than columns on `profiles` for three reasons: BRD §6.2
/// models it as its own entity; the sensitivity differs sharply from a display
/// name; and Phase 3 adds a `geography(Point,4326)` column and a GiST index
/// here (BRD §4.2), which has no business on the row every public profile view
/// reads.
///
/// The columns are deliberately graded, so that reading the wrong one is a
/// visible mistake rather than a silent leak:
///
///   outwardCode      public    a postal district, thousands of addresses
///   town             public    coarse, and what makes the district legible
///   postcode         private   full — needed to geocode, identifies ~15 homes
///   encryptedDetail  private   the street lines, and the actual front door
///
/// Coordinates and the §8.4.1 fuzz offset are **not here yet**. They arrive in
/// Phase 3 with the search that needs them; storing a precise point before
/// anything queries it would be personal data held for no current purpose,
/// against BRD §10.
model Address {
  id String @id @default(uuid()) @db.Uuid

  /// Related to the user rather than to the profile: `users.id` is the platform
  /// identity every foreign key points at (BRD §6), and an address outlives any
  /// particular view of a person.
  ///
  /// Unique for now — one home address each. Listing locations arrive in Phase
  /// 2 and may or may not reuse this table; that is a decision to make with the
  /// listing requirement in hand, not to pre-empt with a nullable discriminator
  /// nothing yet needs.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Full, normalised to `BS7 8AA` by the postcode primitive in @platform/core.
  /// Private: Phase 3 geocodes it, and a booking may release it, but no public
  /// projection selects it.
  postcode String @db.Text

  /// The publishable half, derived from `postcode` on save.
  ///
  /// **Stored rather than truncated at render time, and that is the point.** A
  /// public query selects a column that has never held the inward code, so it
  /// cannot leak one by someone forgetting a `.slice()`. Denormalised on
  /// purpose; the write path is the only place the two can diverge, and it
  /// derives one from the other.
  outwardCode String @db.Text

  /// Post town — "Bristol". Public, and coarse enough to stay public: it makes
  /// an outward code readable to a person judging whether an item is near them.
  town String @db.Text

  /// The street lines, as an AES-256-GCM envelope (BRD §6.2, "encrypted
  /// detail"). One ciphertext over a small JSON object rather than a column per
  /// line, so adding a line later needs no migration and the column count
  /// reveals nothing about what is stored.
  ///
  /// Encrypted because these lines are the difference between "somebody in BS7"
  /// and a specific front door, and nothing operational needs them queryable —
  /// they are read back to show a person their own address, or released to a
  /// counterparty once a booking authorises it. A stolen dump then yields
  /// postal districts instead of addresses.
  encryptedDetail String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("addresses")
}

/// One received provider webhook, recorded so it is processed exactly once.
///
/// CLAUDE.md requires webhook events to be persisted entities rather than
/// in-memory deduplication. In-memory is wrong twice over: it forgets on
/// restart, and it is per-instance, so two API containers each process the
/// same delivery. Providers retry aggressively and Clerk is no exception.
///
/// **No payload column, deliberately.** Idempotency needs only the identifier;
/// the body carries email addresses and names we would then be storing a second
/// time, outside `users`, with no purpose and no retention rule — against the
/// data-minimisation requirement in BRD §10. Clerk retains the event and can
/// redeliver it, so replay does not depend on us keeping a copy.
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  /// `clerk` today. Named rather than assumed, because Stripe arrives in
  /// Phase 5 and two providers will eventually collide on event id.
  provider String @db.Text

  /// The provider's own delivery identifier — Clerk sends Standard Webhooks
  /// headers, so this is `svix-id`. Unique per delivery, stable across retries,
  /// which is exactly what makes it usable as the idempotency key.
  externalId String @db.Text

  eventType String @db.Text

  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Null while in flight. A row that stays null is a delivery we accepted and
  /// failed to apply — the thing worth alerting on once we have somewhere to
  /// send alerts.
  processedAt DateTime? @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@map("webhook_events")
}

/// One security-relevant thing that happened, recorded so it cannot be denied.
///
/// **Append-only.** BRD §17's risk table calls for immutable audit logs, and the
/// port above this table offers no update and no delete — the same discipline
/// the ledger will have. A log that can be edited by the code it audits is a
/// log that proves nothing about that code.
///
/// **It records that a value changed, never what it changed to** (BRD §6.2,
/// "before/after hash"). Storing the values would make this table a second,
/// longer-lived copy of exactly the personal data the rest of the system is
/// careful about — retained six years while the original is erasable, which
/// inverts the retention rules in §10.1. ADR 0017.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Who did it. Nullable for actions the system takes on nobody's behalf.
  ///
  /// A foreign key rather than a loose id, because an audit trail naming an
  /// actor that never existed is worse than no trail. Accounts are soft-deleted
  /// (see `User.deletedAt`), so this survives a deletion request — which is the
  /// point: §10.1 retains security logs for a year hot and six years cold, and
  /// erasing the evidence along with the account would defeat that.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  /// Dotted and past-tense — `profile.updated`, `account.provisioned`.
  ///
  /// A string rather than an enum: a Postgres enum needs a migration to add a
  /// value, so every new audited action in every future module would queue
  /// behind a schema change. The vocabulary is defined in the audit module and
  /// asserted there instead.
  action String @db.Text

  /// What it happened to. Deliberately not a foreign key: the target may be a
  /// profile, a listing or a booking, and a polymorphic reference cannot be
  /// constrained without a column per type. Integrity here is worth less than
  /// being able to audit anything.
  targetType String @db.Text
  targetId   String @db.Uuid

  /// HMAC-SHA256 of the canonical state before and after, keyed with a secret
  /// the database does not hold.
  ///
  /// Not a bare hash, though the BRD says "hash". A display name has a tiny
  /// value space, so an unkeyed digest is guessable offline by anybody holding
  /// this table — the protection would be theatre. Keyed, the digests still
  /// compare equal for equal inputs, which is all change-detection needs, and
  /// tell an attacker nothing. `beforeHash` is null for a creation.
  beforeHash String? @db.Text
  afterHash  String? @db.Text

  /// Why the actor did it.
  ///
  /// BRD §8.13: "Every admin action records actor, **reason**, target and
  /// before/after state." Nullable because an ordinary user action has no
  /// reason to give — somebody editing their own profile is not accountable to
  /// anyone for it — while an administrator reaching into another account is.
  /// The requirement is enforced where the distinction exists, in the admin
  /// routes, rather than by a NOT NULL that would force every user action to
  /// invent one (ADR 0021).
  reason String? @db.Text

  /// The client's address, as forwarded by the web app.
  ///
  /// Nullable because it genuinely is sometimes unknown: the API is not
  /// reachable from the internet, so it never sees a browser directly and this
  /// value is only as good as the hop that forwarded it. Recording the web
  /// container's own address instead would be misleading evidence in a security
  /// log, which is worse than an empty column. ADR 0017.
  ///
  /// `inet` rather than text so a malformed value is rejected by Postgres
  /// rather than stored and believed.
  ipAddress String? @db.Inet

  /// Which sign-in this happened in — Clerk's `sess_…`, from the `sid` claim.
  ///
  /// The join key to `AuthenticationEvent.clerkSessionId`, and named identically
  /// because it is the same value: a person's activity page can then say which
  /// sign-in an action belongs to instead of leaving them to match timestamps by
  /// eye. That is what BRD §8.1 wants the two records for — "signed in from an
  /// unrecognised device, and then changed the account email" is a sentence
  /// neither table can form alone.
  ///
  /// **Not a foreign key**, deliberately. A session event can be missed — the
  /// webhook races the account's first request (ADR 0025) — and an audit write
  /// is fail-closed, so a constraint here would turn a dropped delivery into a
  /// failed user action. The reference is advisory; an unmatched id simply shows
  /// no device, which is what the page already does for a sign-in it never saw.
  ///
  /// **Not indexed.** Nothing queries by it: the activity page fetches both
  /// lists for its own reasons and correlates them in memory. An index for a
  /// query nobody runs is write cost with no read.
  ///
  /// Nullable for actions no session is behind — a provider webhook, a
  /// system-initiated change — and for every row written before this column
  /// existed. Text rather than uuid: Clerk's ids are prefixed strings, not
  /// UUIDs, which is why `AuthenticationEvent` stores them the same way.
  ///
  /// Survives erasure, exactly as `ipAddress` above does. §10.1 retains these
  /// rows for six years and the identifier is less revealing than the address
  /// beside it; the sign-in row it points at is redacted, so the device and
  /// place are gone either way (ADR 0025).
  clerkSessionId String? @db.Text

  /// Stored UTC. No `updatedAt`, because nothing updates.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Serves the one query that exists: "what happened on my account, newest
  /// first". Composite rather than two indexes — a scan of every entry an actor
  /// ever made, sorted afterwards, is the shape that gets slow first.
  @@index([actorId, createdAt(sort: Desc)])

  /// The mirror of the above, for "what did somebody else do to my account".
  ///
  /// A person's activity page merges both directions, so every page load runs
  /// this query too. Without it the target side is a sequential scan of the
  /// whole table — and this table only ever grows, because nothing deletes from
  /// it and §10.1 retains security logs for six years.
  @@index([targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// An administrative action that needs a second administrator to agree.
///
/// BRD §8.13: "High-risk actions require step-up authentication and, for
/// selected actions, dual approval." §17 names dual approval as a mitigation
/// for admin misuse, beside least privilege, MFA and immutable audit logs.
///
/// **The two-person rule is a CHECK constraint, not only a service check.** The
/// same reasoning as the booking overlap constraint (ADR 0004): a rule that
/// exists only in application code is a rule the next code path forgets. Here
/// the cost of forgetting is one administrator granting themselves whatever
/// they like, so the database refuses it independently of anything above it.
///
/// Rows are never deleted. A refused or expired proposal is part of the record
/// of what administrators tried to do, which is most of the point.
model AdminApproval {
  id String @id @default(uuid()) @db.Uuid

  /// What is being proposed — `role.changed` today.
  ///
  /// Text with a closed union in code, for the reason `AuditLog.action` is:
  /// a Postgres enum would put every future approvable action behind a schema
  /// migration.
  action String @db.Text

  /// What it would happen to. `targetType` is text for the same polymorphic
  /// reason the audit log's is; today it is always `user`.
  targetType String @db.Text
  targetId   String @db.Uuid

  /// The parameters of the proposed change — `{"role":"ADMIN"}` today.
  ///
  /// JSON rather than a column per action, because the alternative is a table
  /// that grows a nullable column every time an action is added and where no
  /// row ever uses more than one of them. The shape is validated in code
  /// against the closed action union before it is written.
  payload Json @db.JsonB

  proposedById   String   @db.Uuid
  proposedBy     User     @relation("ProposedApprovals", fields: [proposedById], references: [id])
  /// Why. Mandatory here, unlike `AuditLog.reason` — every row in this table is
  /// an administrative action, so there is no ordinary user action to burden.
  proposedReason String   @db.Text
  proposedAt     DateTime @default(now()) @db.Timestamptz(3)

  /// When the proposal stops being approvable.
  ///
  /// A window rather than an indefinite queue: an approval sitting for a month
  /// is approved against circumstances nobody remembers, and a stale queue is
  /// one people rubber-stamp to clear.
  expiresAt DateTime @db.Timestamptz(3)

  /// Set together, in one transaction with the effect itself.
  ///
  /// There is deliberately no separate "executed" timestamp. Approval *is* the
  /// execution — a window in which a decision is recorded but not applied is a
  /// window somebody has to reconcile, and this way a failure to apply rolls
  /// the approval back and leaves the proposal pending and retryable.
  approvedById   String?   @db.Uuid
  approvedBy     User?     @relation("GrantedApprovals", fields: [approvedById], references: [id])
  approvedReason String?   @db.Text
  approvedAt     DateTime? @db.Timestamptz(3)

  cancelledById   String?   @db.Uuid
  cancelledBy     User?     @relation("CancelledApprovals", fields: [cancelledById], references: [id])
  cancelledReason String?   @db.Text
  cancelledAt     DateTime? @db.Timestamptz(3)

  /// Serves the one query: the pending queue, newest first.
  @@index([proposedAt(sort: Desc)])
  @@map("admin_approvals")
}

/// A sign-in, or the end of one.
///
/// BRD §8.1 asks for "authentication events, device/session management and
/// suspicious-login alerts". This is the first of the three: the record a
/// person reads to answer "has anybody else been in my account".
///
/// **A separate table rather than more `audit_logs` rows, and the reason is the
/// shape.** Every other audited action is something somebody chose to do, and
/// `audit_logs` stores digests rather than values precisely so it can be
/// retained for six years without holding personal data (ADR 0017). An
/// authentication event is the opposite on both counts: it is not a deliberate
/// act, and it is worthless unless it holds the very values a digest would
/// destroy — a person cannot recognise an intruder from an HMAC. Widening
/// `AuditEntry` with seven columns that twenty-five other actions leave null is
/// the optional-field anti-pattern ADR 0016 rejected for profiles.
///
/// Volume differs too. One row per sign-in against one per deliberate action,
/// and nothing prunes either — see the retention note on `occurredAt`.
///
/// The person still reads one merged history: their activity page joins this
/// with both directions of the audit trail.
model AuthenticationEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Whose account. Required, unlike the audit log's actor — an authentication
  /// event with no account is not a degraded record, it is meaningless.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation, and it is
  /// the right one: accounts are soft-deleted (see `User.deletedAt`) so this
  /// never fires in production. It fires in tests, where clearing `users`
  /// without clearing this first now fails — children before parents.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Clerk's `sess_…`, the session this event is about.
  ///
  /// A reference to the provider's record, never an identity of ours — the same
  /// rule `clerkUserId` follows. Kept because it is what lets a person match a
  /// row here against a device in Clerk's own session list, and what a support
  /// enquiry cites.
  clerkSessionId String @db.Text

  /// `started`, `ended`, `removed` or `revoked`.
  ///
  /// Our vocabulary, not Clerk's four `session.*` event names, because the
  /// mapper's job is to stop provider shape at the boundary. Text rather than a
  /// Postgres enum for the reason `AuditLog.action` gives: an enum puts every
  /// new value behind a schema migration.
  event String @db.Text

  /// When it happened **at Clerk**, not when we stored it.
  ///
  /// Webhooks are asynchronous and can be redelivered hours later, so the two
  /// genuinely differ and only this one answers "when was I signed in". Stored
  /// UTC and rendered in the viewer's zone, per BRD §6.1.
  ///
  /// **Nothing prunes this table.** §10.1 retains security logs six years and
  /// no scheduler exists yet, so rows accumulate per sign-in indefinitely. That
  /// is a known limitation recorded in the handoff rather than a design intent.
  occurredAt DateTime @db.Timestamptz(3)

  /// Where the sign-in came from, as Clerk's geo-location resolved it.
  ///
  /// **Every one of these is nullable, and that is Clerk's shape rather than
  /// caution.** `latest_activity` is optional on the session payload, and each
  /// field within it is optional again apart from `is_mobile`. A correctly
  /// delivered event can carry none of them, and inventing a value to fill a
  /// column would put a guess in a security record.
  ///
  /// `inet` rather than text so Postgres rejects a malformed address instead of
  /// storing it — and note real values here are frequently IPv6, which `inet`
  /// holds and a `varchar(15)` would have silently truncated.
  ipAddress      String?  @db.Inet
  browserName    String?  @db.Text
  browserVersion String?  @db.Text
  deviceType     String?  @db.Text
  isMobile       Boolean?

  /// Stored UTC. No `updatedAt`: like the audit log, nothing updates a row
  /// here. Erasure is the one exception and it nulls columns rather than
  /// rewriting history — see the eraser.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One row per event per session.
  ///
  /// Idempotency already comes from the `webhook_events` ledger, which refuses
  /// a redelivered *delivery*. This guards the case that ledger cannot see: the
  /// same logical event arriving under two delivery ids. The recorder treats a
  /// conflict as already-done rather than an error, because a webhook handler
  /// that 500s on a duplicate is one Clerk retries forever.
  @@unique([clerkSessionId, event])

  /// Serves the only query: this account's sign-ins, newest first, for the
  /// activity page and the data export.
  @@index([userId, occurredAt(sort: Desc)])
  @@map("authentication_events")
}

/// A rental category — the unit of configuration the whole engine turns on.
///
/// BRD §1.2 makes the platform category-agnostic: categories, fees, attributes,
/// radii, deposits and policies are versioned configuration and never code. This
/// table is the identity half of that. It holds only what never changes about a
/// category — which is, deliberately, almost nothing.
///
/// **Everything configurable lives on `CategoryVersion`, not here.** A column
/// here would be a fact with no version attached, and §8.2 requires that
/// "existing bookings retain the configuration version under which they were
/// created". A booking cannot pin a value that is stored where it can be
/// overwritten.
model Category {
  id String @id @default(uuid()) @db.Uuid

  /// Stable public identity: the URL segment, and the SEO slug §8.17 needs to
  /// keep canonical. Immutable by convention rather than by constraint — the
  /// display name is what an administrator renames, and renaming that mints a
  /// version while the slug stays put so links do not rot.
  slug String @unique @db.Text

  versions CategoryVersion[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("categories")
}

/// One immutable snapshot of a category's configuration.
///
/// **The current configuration is the highest `versionNumber` for the category.**
/// There is deliberately no `currentVersionId` pointer on `Category`: that would
/// be a cycle between two required foreign keys, which Postgres will only insert
/// into with deferred constraints and which Prisma models badly — and it would
/// introduce a second source of truth that can disagree with the rows. The
/// unique constraint below makes "highest" unambiguous, and a btree scans
/// backwards, so finding it costs an index seek.
///
/// **Rows are never updated.** A trigger enforces it rather than trusting the
/// port, because the port is the thing somebody edits when they need to
/// "correct" a value. `UPDATE` is refused; `DELETE` is not, so test teardown and
/// a future category removal both remain possible — and from Phase 4 a booking's
/// foreign key is what will actually hold a referenced version in place.
model CategoryVersion {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Monotonic per category, starting at 1. The unique constraint below is what
  /// makes concurrent edits safe: two administrators saving at once produce the
  /// same next number, and the second insert fails rather than silently winning.
  versionNumber Int

  /// What an administrator sees and renames. Not the slug — see `Category.slug`.
  name String @db.Text

  /// How much care this category's items demand, which later drives deposit
  /// bands, verification and prohibited items (§8.2).
  ///
  /// Text with a closed union in code, exactly as `AuditLog.action` and
  /// `AdminApproval.action` are, so adding a level is not a schema migration.
  /// The *set* of levels is domain vocabulary; the *assignment* to a category is
  /// configuration, which is the distinction CLAUDE.md's rule is drawing.
  riskLevel String @db.Text

  /// The category's attribute schema, in render order (ADR 0027, BRD §8.2).
  ///
  /// A closed vocabulary of four types — `text`, `number`, `choice` and
  /// `choice-many` — validated by `categoryAttributesSchema` in
  /// @platform/contracts, which is the only thing that may write here. Postgres
  /// checks that the value is JSON; it does not and cannot check that it is a
  /// schema this build can render, so the adapter parses on the way out.
  ///
  /// **JSON rather than a child table, deliberately.** This row is immutable by
  /// the trigger below, and a JSON column inherits that guarantee; rows in a
  /// child table would not, and one appended against last month's version would
  /// silently change the terms of every booking pinned to it. The schema is also
  /// always read whole, never queried attribute by attribute, and its order is
  /// meaningful — which a relational table would need a position column to keep.
  ///
  /// Defaults to an empty schema, which is exactly what a category configured
  /// before slice 2.2 has. No backfill invents a schema nobody chose.
  attributes Json @default("[]") @db.JsonB

  /// Which transport requirements this category offers a listing, and the weight
  /// each one is suggested up to (BRD §8.3, ADR 0031, slice 2.4c).
  ///
  /// **A selection from a closed platform vocabulary, not a per-category option
  /// list.** §8.3 requires the requirement to reach the booking summary, the
  /// collection instructions, the handover checklist and a search filter — four
  /// consumers that must be able to ask any listing what it needs. If each
  /// category spelled its own options, `van` here and `van_required` there would
  /// be two different filters with nothing to notice. The vocabulary lives in
  /// @platform/contracts and adding a value to it is a deploy.
  ///
  /// **On the version rather than on `Category`**, with the rest of the
  /// configuration and for the same reason: §8.2 requires a booking to be
  /// interpreted under the configuration in force when it was made, and a
  /// listing pins this row. Withdrawing an option must not change what an
  /// existing listing claims about itself.
  ///
  /// Stored in the vocabulary's display order, which the contract normalises on
  /// the way in — so two administrators ticking the same boxes in a different
  /// order produce the same value, and the audit digest does not report a change
  /// nobody made.
  ///
  /// Defaults to an empty selection, which is what every category configured
  /// before this migration has. No backfill invents a selection nobody chose;
  /// such a category simply asks nothing about transport until it is
  /// reconfigured.
  transportOptions Json @default("[]") @db.JsonB

  /// Which statutory reporting head this category's activity falls under
  /// (§8.14.2). `none`, `means_of_transport`, `personal_service` or
  /// `sale_of_goods`, as a closed union in code exactly like `riskLevel`.
  ///
  /// **On the version rather than on `Category`, and that is not a detail.**
  /// This is the one configuration value that can change the platform's
  /// regulatory status, and §8.2 requires a booking to be interpreted under the
  /// configuration in force when it was made. A flag stored on the category
  /// would answer "is this reportable now"; a report has to answer "was this
  /// reportable when it happened".
  ///
  /// Defaults to `none`, which is true rather than merely convenient: §8.14.1
  /// determined that rental of general goods is not a Relevant Activity, so
  /// every category configured before this migration was correctly outside
  /// scope.
  reportableActivity String @default("none") @db.Text

  /// What the platform charges on a booking in this category (BRD §8.2, §3.4,
  /// slice 2.7a).
  ///
  /// **Scalar columns, not the `Json` treatment `attributes` gets**, and the
  /// difference is the shape rather than the taste. An attribute schema is
  /// variable-length, ordered, and always read whole; a fee policy is four fixed
  /// values that later phases query *across* categories — §3.4.3's worked
  /// example, Phase 5's payout reconciliation and any "which categories charge
  /// more than X" question all want columns rather than a blob every row has to
  /// be parsed to answer.
  ///
  /// **On the version, and that is the whole reason this row exists.** §8.2
  /// requires a booking to be interpreted under the configuration in force when
  /// it was made. A rate on `Category` answers "what do we charge now"; a payout
  /// dispute eighteen months later needs "what did we charge then", and only an
  /// immutable row can answer that.
  ///
  /// Rates are **basis points** — hundredths of a percent, 15% is `1500`.
  /// Integer for ADR 0002's reason applied one step early: a rate is not money,
  /// but it is what money gets multiplied by, so a float here reaches the ledger
  /// just as surely. See `MAX_FEE_BASIS_POINTS` in @platform/contracts.
  ///
  /// Both default to zero, which is what every category configured before this
  /// migration has. **No backfill invents a fee nobody agreed to** — the same
  /// call the attribute schema and the transport options each made. Zero is safe
  /// where a guess is not, because §8.2 already forbids enabling a category for
  /// public booking before §3.4.3's worked example exists.
  ownerCommissionBasisPoints Int @default(0) @db.Integer
  renterFeeBasisPoints       Int @default(0) @db.Integer

  /// The booking total below which a booking may not be submitted (§3.4.2), and
  /// the floor under the platform fee when the percentage falls below it.
  ///
  /// Integer minor units plus the currency on the same record, exactly as
  /// `Listing.replacementValue*` (ADR 0002). The floors are configuration here;
  /// the *booking* minimum is enforced in Phase 4, where a booking exists to
  /// refuse. The **fee** floor is pricing logic and applies from 2.7b: 8% of a
  /// £6 day is 48p, which does not cover the card processing on it.
  minimumBookingTotalAmount   Int    @default(0) @db.Integer
  minimumBookingTotalCurrency String @default("GBP") @db.Text
  minimumPlatformFeeAmount    Int    @default(0) @db.Integer
  minimumPlatformFeeCurrency  String @default("GBP") @db.Text

  /// BRD §8.7.2's three-part excess model, as versioned configuration (slice
  /// 5.5a): how much of a loss a renter bears, and the most recoverable from
  /// them on one booking.
  ///
  /// **All five are nullable together, and all five NULL means the category
  /// requires no damage security** — which §8.7.2 explicitly permits. ADR 0052
  /// records why that is expressed by absence rather than by a boolean beside
  /// optional values.
  ///
  /// **Two `CHECK`s enforce it and Prisma can see neither.**
  /// `damage_security_is_complete` refuses a partial band, a floor above the
  /// ceiling, a zero ceiling and a percentage outside 0–10000 basis points;
  /// `excess_band_currencies_agree` keeps the two currencies equal. The contract
  /// re-applies the same rules in `damageSecurityPolicySchema`, because a row
  /// this load-bearing is worth asserting on both sides of the boundary — the
  /// same call `maximumRentalDays` makes below.
  ///
  /// Basis points, never a fraction (ADR 0033) — the number is multiplied by
  /// somebody's replacement value, so a float here lands in a card hold.
  ///
  /// On the *version* for §8.2's reason, which §8.7.2 restates in its own words:
  /// *"Bookings retain the values current at creation."*
  excessFloorAmount           Int?    @db.Integer
  excessFloorCurrency         String? @db.Text
  excessPercentageBasisPoints Int?    @db.Integer
  recoveryCeilingAmount       Int?    @db.Integer
  recoveryCeilingCurrency     String? @db.Text

  /// The longest hire this category permits, in local calendar days (BRD §8.5.3,
  /// slice 4.4a).
  ///
  /// **A legal bound rather than a commercial one.** Under the Consumer Credit
  /// Act 1974 a hire to an individual that is *capable of subsisting* beyond
  /// three months is a regulated consumer hire agreement, and arranging those
  /// without FCA authorisation is an offence. "Capable of subsisting" is what
  /// makes an *unbounded* period the problem, whatever any single rental does.
  ///
  /// **A `CHECK` bounds it at 88 in the migration, and Prisma cannot see that.**
  /// §8.5.3 permits a higher cap for business-heavy categories; ADR 0043 refuses
  /// to let a business publish here at all, so that case does not exist and the
  /// ceiling stands. `refusePeriod` re-applies it in code as well, because a
  /// value this load-bearing is worth asserting on both sides of the boundary.
  ///
  /// On the *version*, like every other configurable fact, so a booking is
  /// judged against the cap it was actually made under — which is what lets a
  /// completed rental still read as compliant after the category is changed.
  maximumRentalDays Int @default(88) @db.Integer

  /// How long an owner has to answer a request, in hours (BRD §8.6, slice 4.5a).
  ///
  /// §8.6: *"Owner receives notification and accepts or declines **before a
  /// configurable deadline**"*, and §6.2 puts an **expiry** on the `Booking`
  /// entity. Neither existed before this slice — so a request could not expire,
  /// and 4.7's expiry worker would have had nothing to read.
  ///
  /// **48 hours by default, which is engineering judgement rather than BRD text**
  /// — see `DEFAULT_REQUEST_EXPIRY_HOURS` for the two things that bound it. A
  /// `CHECK` holds it between 1 hour and two weeks; unlike the duration cap above
  /// that ceiling is commercial rather than legal, so it is generous and exists
  /// only to catch a typo.
  ///
  /// On the *version*, like every other configurable fact, so a request is judged
  /// against the deadline in force when it was made.
  requestExpiryHours Int @default(48) @db.Integer

  /// Who made this configuration what it is. BRD §6.2 puts an author on the
  /// entity; the corresponding audit entry carries the reason and the digests.
  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listings Listing[]

  /// Quotes priced under this configuration (slice 4.4b). `ON DELETE RESTRICT`,
  /// so a version somebody was given a price under cannot be deleted while the
  /// price still exists to be explained. Declared because Prisma requires both
  /// ends; nothing reads a version's quotes.
  quotes Quote[]

  /// Bookings made under this configuration (slice 4.5a). `ON DELETE RESTRICT`
  /// for the same reason and a stronger one: §8.2 requires a booking to be
  /// interpretable under the terms it was made under, and §10.1 retains booking
  /// records for six years.
  bookings Booking[]

  /// Payment attempts divided by this configuration's fee policy (slice 5.2b).
  /// `ON DELETE RESTRICT` for the reason above and the plainest one there is: a
  /// payment whose rate cannot be looked up is a payout nobody can explain.
  paymentIntents PaymentIntent[]

  /// Both the "no two versions share a number" rule and the index that answers
  /// "what is current". One constraint, two jobs, no second index to maintain.
  @@unique([categoryId, versionNumber])

  /// Redundant on its own — `id` is already unique — and it exists to be the
  /// target of a composite foreign key from `listings`.
  ///
  /// A listing stores both the category and the pinned version (BRD §6.2 names
  /// both). Storing them as two independent foreign keys would allow a row
  /// claiming category A and a version belonging to category B, which is the
  /// second-source-of-truth problem slice 2.1 refused for `currentVersionId` —
  /// except here nothing would ever notice. Referencing this pair instead makes
  /// the disagreement unrepresentable rather than merely unlikely.
  @@unique([id, categoryId])
  @@map("category_versions")
}

/// A rentable item, as its owner describes it (BRD §8.3, §6.2).
///
/// **The first row a user creates rather than an administrator**, which is why
/// ownership is a column here rather than an assumption anywhere else. Every
/// read of this table is scoped by `ownerId` until slice 2.10 publishes a public
/// projection.
///
/// A draft is deliberately allowed to be incomplete. §8.3 says owners "create
/// draft listings and save progress", so most of what a listing eventually needs
/// — location, prices, media, availability, rules — is absent here and arrives
/// in 2.5 through 2.8. Completeness is a publication rule, not a storage rule.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  /// Whose item it is.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation. It never
  /// fires in production because accounts are soft-deleted rather than removed.
  ///
  /// **It is not what decides whether a listing survives its owner, and reading
  /// it that way is the trap** (slice 2.8b). Since 10 August 2026 deleting an
  /// account deletes its listings, and that happens through a deliberate
  /// `deleteMany` in `PrismaListingStore.deleteAllOwnedBy` — an application
  /// decision, taken where §10.1's distinction between erasable data and
  /// retained records can actually be read. `RESTRICT` stays because the
  /// alternative, `CASCADE`, would make that decision silently at the schema
  /// level: once a booking references a listing, a cascade from `users` would
  /// destroy the other party's rental history with nothing in the application
  /// having chosen to.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  /// The category, and the exact configuration version this listing was written
  /// against — BRD §6.2 puts both on the entity.
  ///
  /// **One composite foreign key, not two separate ones.** `(categoryVersionId,
  /// categoryId)` references the matching unique pair on `category_versions`, so
  /// a listing cannot claim one category while pinning a version belonging to
  /// another. Two independent keys would each be individually valid in exactly
  /// that broken state.
  ///
  /// The pin is what makes the attribute values in slice 2.4b mean something: it
  /// records which schema they were entered and validated against, so
  /// reconfiguring a category cannot retroactively invalidate a listing.
  categoryId        String          @db.Uuid
  categoryVersionId String          @db.Uuid
  categoryVersion   CategoryVersion @relation(fields: [categoryVersionId, categoryId], references: [id, categoryId])

  title       String @db.Text
  /// May be empty on a draft, and that is a real value rather than a missing
  /// one — §8.3's "save progress". Publication requires prose (2.8).
  description String @db.Text

  /// The answers to this category's attributes, keyed by attribute key
  /// (ADR 0027, BRD §8.2, slice 2.4b).
  ///
  /// **An object, where the definitions are an array.** The definitions carry
  /// render order and this does not need to: the schema on the pinned version is
  /// the ordering authority, and a second one here could disagree with it.
  ///
  /// **Only the keys that were answered are present.** An unanswered attribute
  /// is absent rather than null, so the platform has one representation of "not
  /// answered" instead of two that every later reader must remember to treat
  /// alike. `required` is not enforced on a draft — §8.3 says owners save
  /// progress, and completeness is a publication rule (2.8).
  ///
  /// Validated by `validateAttributeValues` in @platform/contracts **against the
  /// schema on the version this row pins**, never against the category's current
  /// one. That is what stops a reconfiguration retroactively invalidating a
  /// listing, and it is why renaming an attribute key cannot orphan a stored
  /// value: the rename mints a new version, and this row still points at the old
  /// one, whose schema still has the old key.
  ///
  /// Postgres checks only that the value is JSON. It cannot check that the keys
  /// match a schema it would have to read from another row, so the adapter is
  /// where that holds.
  attributes  Json   @default("{}") @db.JsonB

  /// What replacing the item would cost, as integer minor units plus the
  /// currency, on the same record (ADR 0002, CLAUDE.md).
  ///
  /// **The first money stored anywhere in this system.** §8.7.1 derives the
  /// damage excess from it — "the greater of a fixed floor or a percentage of
  /// replacement value" — so this number becomes an amount held on somebody's
  /// card. `Int` rather than `Decimal` or `Float`: pence are whole, and a float
  /// here would be a rounding error with a legal consequence.
  ///
  /// The currency is stored rather than assumed. Today there is one; the day
  /// there are two, every bare number becomes ambiguous with nothing to
  /// disambiguate it.
  replacementValueAmount   Int    @db.Integer
  replacementValueCurrency String @db.Text

  /// What it costs to rent (BRD §8.5.2, §8.3, slice 2.7b).
  ///
  /// Integer minor units plus the currency on the same record (ADR 0002), the
  /// same shape `replacementValue` above uses.
  ///
  /// **All nullable, because §8.3 makes a draft permissive** — an owner saves
  /// progress and completeness is a publication rule. **Slice 2.8 must refuse to
  /// publish a listing with no daily rate**, for the reason it must refuse one
  /// with no coordinates: it would be a listing nothing can price and nobody can
  /// book, which is a legitimate draft and an illegitimate published listing.
  ///
  /// **The daily rate is the spine.** The other two are alternatives to it, not
  /// replacements — a `CHECK` refuses a weekend or weekly rate with no daily one
  /// beside it, because such a row describes an item rentable for three days but
  /// not one, with nothing saying so.
  ///
  /// **There is no hourly rate**, though §8.5.2 names one. In a peer-to-peer
  /// model the renter drives to a stranger's house to collect, so the round trip
  /// exceeds the rental, and nothing in the launch category is hired by the
  /// hour. An unused rate is a case every consumer from the quote engine to the
  /// handover checklist carries forever. A column away if a later category wants
  /// it. Configurable discounts are absent for a different reason: a discount
  /// applies to a duration, and Phase 2 has no dates.
  ///
  /// One currency column serves all three. Two rates on one listing in different
  /// currencies is not a state anything downstream could price, and §6.1's rule
  /// is that the code travels with the amount — which it does, for the record as
  /// a whole.
  dailyRateAmount   Int?   @db.Integer
  weekendRateAmount Int?   @db.Integer
  weeklyRateAmount  Int?   @db.Integer
  rateCurrency      String @default("GBP") @db.Text

  /// What is needed to collect and carry this item (BRD §8.3, ADR 0031,
  /// slice 2.4c-ii).
  ///
  /// One of the platform's closed vocabulary — `hand_carryable`, `car_boot`,
  /// `estate_or_hatchback`, `van_required`, `trailer_required` — as text with
  /// the union in code, exactly like `status` and `riskLevel`. **Which of them
  /// are legal for this listing is category configuration**, held on the version
  /// this row pins, so no CHECK constraint here could express it without reading
  /// another table's JSON. The service validates against the pinned options and
  /// the adapter refuses a value this build does not know.
  ///
  /// **Nullable, because a draft has not necessarily said yet.** §8.3 lets
  /// owners save progress, so completeness is a publication rule (2.8) — which
  /// inherits the question of what publishing means for a category that offers
  /// no options at all.
  transportRequirement String? @db.Text

  /// Whether it takes two people to lift.
  ///
  /// **A separate column, not a value in the vocabulary above** (ADR 0031). The
  /// BRD's example list puts "two-person lift" beside the vehicle sizes, but an
  /// item can need a van *and* two people, and one column would force an owner
  /// to discard one of two true facts.
  ///
  /// Not nullable and defaulted false: unlike the requirement, this has a
  /// meaningful answer for an item nobody has thought about yet, and "we do not
  /// know" and "no" would be two states every later reader has to treat alike.
  /// It feeds §8.9's handover checklist regardless of what the category
  /// configured, which is why it is asked of every listing.
  requiresTwoPersonLift Boolean @default(false)

  /// The **publishable** half of where this item is collected from (§8.4.1,
  /// slice 2.5a). `BS7` and `Bristol`.
  ///
  /// **On the listing, while the precise half lives in `listing_locations`.**
  /// The split is the disclosure rule made structural. A listing row is public
  /// content — 2.10 renders it, Phase 3 searches it, and both will select it
  /// broadly — so a full postcode stored here would be personal data on a row
  /// whose whole purpose is to be shown to strangers, protected only by every
  /// future author remembering a `select`. Instead the private half is a
  /// different table nobody joins by accident, and these two columns have never
  /// held anything finer than a postal district covering thousands of homes.
  ///
  /// **Derived on write from the stored postcode**, in one place, exactly as
  /// `addresses.outwardCode` is. That is the only place the two can diverge.
  ///
  /// Both null together or both set together — a `CHECK` enforces it below.
  /// Nullable at all because a draft legitimately has not said where the item
  /// lives (§8.3); publication is where that becomes required (2.8).
  ///
  /// **They no longer survive erasure, because the listing does not** (slice
  /// 2.8b). This said the opposite until 10 August 2026: deleting an account
  /// removed the `listing_locations` row and left these, so a listing collapsed
  /// to the district it was always published at. The product owner's decision is
  /// that deleting an account deletes its listings, and §10.1 permits it while
  /// nothing the platform must retain refers to one.
  ///
  /// **These columns still hold nothing finer than a postal district**, which is
  /// the reason they are here and is unchanged: they are the publishable half,
  /// and the public projection reads them instead of joining `listing_locations`
  /// at all (§8.4.1). When Phase 4 makes a booking reference a listing, erasure
  /// becomes delete-if-unreferenced and hide-if-referenced — and the retained
  /// listing collapses to exactly these two columns again.
  outwardCode String? @db.Text
  town        String? @db.Text

  location ListingLocation?

  /// `DRAFT`, and nothing else until slice 2.8 brings the rest of the lifecycle.
  ///
  /// Text with a closed union in code, exactly as `riskLevel` and
  /// `reportableActivity` are. Present now rather than later because
  /// retrofitting a status onto rows that bookings already reference is a
  /// migration nobody wants, and because a listing with no status is
  /// indistinguishable from one that is live.
  status String @db.Text

  /// What the **platform** permits, as distinct from what the owner wants
  /// (ADR 0041, slice 2.8c-i).
  ///
  /// `APPROVED`, `UNDER_REVIEW` or `REJECTED`. Text with the union in code, like
  /// `status` beside it.
  ///
  /// **A second column rather than more values in `status`**, and the split is
  /// the decision. `status` is written by the owner and expresses their intent;
  /// this is written by an administrator and expresses ours. Folded together, a
  /// rejection would overwrite the owner's intent and reinstatement would have
  /// to guess what to restore — republishing a listing its owner had paused.
  ///
  /// A listing is public only when **both** agree, which `isPubliclyVisible` in
  /// `@platform/contracts` is the single place to ask. A query filtering on
  /// `status` alone now returns rejected listings.
  ///
  /// Defaults to `APPROVED` because §8.3 makes moderation something that flags
  /// rather than a gate every listing queues at — and because a default of
  /// "wait" with no queue behind it (Phase 9) would stop the platform dead.
  moderationState String @default("APPROVED") @db.Text

  /// Why, in the administrator's own words — and the subject reads it verbatim,
  /// as ADR 0024 established for suspension.
  ///
  /// Nullable because `APPROVED` needs none. `moderation_hidden_has_a_reason`
  /// makes it mandatory for every state that hides a listing, written as an
  /// implication so a fourth state inherits the rule rather than slipping past
  /// a list.
  moderationReason String? @db.Text

  /// Who decided, and when. Both null together or both set together
  /// (`moderation_authorship_is_complete`), and both null for a listing nobody
  /// has moderated — which distinguishes the default from a real decision.
  ///
  /// **`Restrict` is stated rather than left to Prisma's default**, and saying so
  /// closes a drift that had been in this file since slice 2.8 (10 August 2026).
  /// The migration wrote `ON DELETE RESTRICT`; this line said nothing, and
  /// Prisma's default for an *optional* relation is `SetNull` — so the schema and
  /// the database disagreed, `prisma migrate diff` emitted the difference on every
  /// run, and the next generated migration would have silently carried it.
  ///
  /// **The database was the correct side.** `SetNull` would quietly rewrite
  /// history to say *nobody* moderated a listing an administrator moderated,
  /// leaving `moderatedAt` set beside a null author — which
  /// `moderation_authorship_is_complete` forbids, so the erasure would fail on the
  /// constraint rather than at the decision. Harmless today only because accounts
  /// are soft-deleted (ADR 0018) and this never fires. It is the same latent
  /// defect `booking_events.actorId` names and states its own `Restrict` to avoid.
  moderatedById String?   @db.Uuid
  moderatedBy   User?     @relation("ListingModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  moderatedAt   DateTime? @db.Timestamptz(3)

  /// The words this listing can be found by — BRD §8.4's free-text filter
  /// (slice 3.3a).
  ///
  /// **Nullable and `Unsupported`, for `listing_locations.fuzzedPoint`'s exact
  /// reason.** Prisma has no `tsvector` any more than it has `geography`, and
  /// §4.2's rule generalises: a *required* `Unsupported` column blocks ordinary
  /// Prisma Client writes on the model, and this is the central model of the
  /// entire catalogue. Nullable, it stays fully writable and only the search
  /// query needs raw SQL.
  ///
  /// **Derived from `title` and `description` by trigger, never written by
  /// application code** — again the same shape as the fuzzed point, deliberately,
  /// so there is one pattern in this schema for "a column Prisma cannot hold"
  /// rather than two. Title is weighted above description.
  ///
  /// **Nothing from `listing_locations` is in it, and nothing may be added.**
  /// That table holds the encrypted street lines and the full postcode, and a
  /// text index over them would be exactly the disclosure §8.4.1's two-table
  /// split exists to make structurally impossible. The publishable district and
  /// town are not in it either — they are already a filter of their own, and
  /// indexing them would let a keyword match a place name and quietly widen a
  /// search nobody widened.
  searchDocument Unsupported("tsvector")?

  /// Every booking and request against this item (slice 4.2).
  ///
  /// **`ON DELETE RESTRICT`, and it is what changes how a listing is erased.**
  /// Until this relation existed, deleting an account deleted its listings
  /// outright (product owner's decision, 10 August 2026). A booking now points
  /// here, and deleting the row would destroy the *renter's* record of what
  /// they hired — so `deleteAllOwnedBy` deletes only the listings nothing has
  /// booked, and collapses the rest to the district and town they were always
  /// published at. That inversion was predicted in the decision itself.
  bookings Booking[]

  /// Periods the owner has declared this item unavailable (slice 4.3a).
  ///
  /// `ON DELETE CASCADE`, unlike `bookings` above — see `AvailabilityBlock`.
  /// A block is the owner's own note about their own item, so it goes when the
  /// listing does; a booking is somebody else's record and does not.
  availabilityBlocks AvailabilityBlock[]

  /// Prices quoted for this item. **`ON DELETE CASCADE`, unlike `quotes.renterId`**
  /// — see the note there for why the two ends differ, and for the erasure bug
  /// making them the same would have caused.
  quotes Quote[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// The only query this slice makes: this owner's listings, newest first. The
  /// owner dashboard (2.9) wants the same order.
  @@index([ownerId, createdAt(sort: Desc)])
  /// Declared here as well as created in the migration so the datamodel and the
  /// database agree — `listing_locations`' GiST index carries the same note and
  /// the same warning. Without it `prisma migrate diff` reports drift and
  /// `migrate dev` would helpfully write a migration dropping the index this
  /// slice's whole query depends on.
  @@index([searchDocument], type: Gin)
  @@map("listings")
}

/// Where a listing actually is — **the half that is never published**.
///
/// A table of its own rather than more columns on `listings`, for three reasons
/// that all point the same way (slice 2.5a).
///
/// **Disclosure.** A listing is public content and this is not. Separating them
/// means the public projection in 2.10 and the search in Phase 3 do not join
/// this table at all, rather than joining it and remembering to exclude columns.
/// A `select` can be forgotten; a join that was never written cannot.
///
/// **Erasure.** Removing everything precise about where somebody lives is one
/// row delete, and "erased" is then unambiguous. The alternative — nulling four
/// columns on a row that must survive — leaves the question of whether a null
/// means erased or never-supplied, on the one table where that distinction is
/// answered years later by a regulator.
///
/// **Slice 2.5b.** The coordinates, the persisted fuzz offset and the
/// `Unsupported("geography(Point,4326)")` column BRD §4.2 requires all belong
/// with the postcode they are derived from. Putting an `Unsupported` column on
/// `listings` would put a raw-SQL-only concern on the central model of this
/// entire phase; here it stays where the raw SQL is meant to be confined.
///
/// **There are no coordinates here yet**, and that is 2.5a's boundary. This
/// slice captures the address and publishes the district; 2.5b geocodes it and
/// displaces it.
model ListingLocation {
  /// The listing itself is the identity — one location per listing, and the
  /// listing id *is* the primary key rather than a surrogate beside a unique
  /// constraint. A second key would allow two rows to exist long enough for
  /// something to read the wrong one.
  listingId String  @id @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// The full postcode, normalised to `BS7 8AA` — **in clear, deliberately.**
  ///
  /// The same decision `addresses.postcode` records, and the same reason: slice
  /// 2.5b geocodes this column, and encrypting a value the geocoder needs would
  /// mean decrypting every row to answer "what is near me". It is the most
  /// sensitive column in this table — about fifteen households, often one
  /// building — and it is protected by living in a table no public query joins,
  /// not by a cipher.
  postcode String @db.Text

  /// The street lines, as an AES-256-GCM envelope, exactly as `addresses` holds
  /// them (ADR 0016).
  ///
  /// One ciphertext over a small JSON object rather than a column per line, so
  /// adding a line later needs no migration and the column count reveals nothing
  /// about what is stored. The **listing id** is bound in as additional
  /// authenticated data, so an envelope copied onto another listing's row fails
  /// to decrypt rather than being served as that listing's address.
  encryptedDetail String @db.Text

  /// Where the postcode actually is (slice 2.5b).
  ///
  /// **Floats, and that is correct — ADR 0002 is about money.** Pence are whole
  /// and a rounding error there is somebody's money; a coordinate is a
  /// continuous quantity with no natural unit, and the nearest whole degree is
  /// 111 km wide. Do not "fix" these into integers on the strength of the money
  /// rule.
  ///
  /// **Nullable, because geocoding depends on a third party.** It can be down,
  /// and it can simply not recognise a valid new postcode — its data is a
  /// snapshot. §8.3 makes a draft permissive, so neither may stop somebody
  /// saving one: the listing keeps its address and reads as "not located yet".
  /// **Slice 2.8 must refuse to publish a listing with no coordinates**, because
  /// a published listing no search can find is worse than a draft.
  ///
  /// **Never returned by a public or pre-booking response** (§8.4.1). It exists
  /// for Phase 7, which hands the renter an exact place once a booking
  /// authorises collection — re-geocoding at handover would make two strangers
  /// meeting depend on a third party being up.
  latitude  Float? @db.DoublePrecision
  longitude Float? @db.DoublePrecision

  /// The persisted fuzz offset — BRD §8.4.1, ADR 0032.
  ///
  /// **Drawn once at random when the coordinates first exist, and never
  /// recomputed.** Recomputing per request leaks the true point through
  /// averaging. Not derived from the listing id either: a derived offset is
  /// invertible, so a leaked key would yield every owner's home address with no
  /// database access at all. Read ADR 0032 before changing any of this.
  ///
  /// Integers: a whole degree of bearing at 1 km is under 18 m, and metre
  /// precision on a deliberate blur is already far finer than the blur.
  fuzzBearingDegrees Int?
  fuzzDistanceMetres Int?

  /// The published point — the true one displaced by the offset above.
  ///
  /// **Stored rather than derived at read time**, and that is the same instinct
  /// as `addresses.outwardCode`: deriving makes the published location the
  /// output of a function somebody can change, and a different earth radius or
  /// rounding would silently move every listing. Storing makes it a fact.
  fuzzedLatitude  Float? @db.DoublePrecision
  fuzzedLongitude Float? @db.DoublePrecision

  /// The GiST-indexed geography for Phase 3's radius query — BRD §4.2.
  ///
  /// **Nullable, and that is load-bearing.** §4.2: *"A **required**
  /// `Unsupported` column blocks ordinary Prisma Client writes on that model."*
  /// Nullable, it does not, so this model stays fully writable through Prisma
  /// and only the radius query needs raw SQL.
  ///
  /// **Derived from the FUZZED point, by trigger, never written by application
  /// code.** On the fuzzed point because it exists to serve public radius
  /// queries and §8.4.1 permits those to touch nothing else — an index on the
  /// true point would be an index no public query may use. ADR 0032 makes that
  /// binding on Phase 3: filtering on the true coordinate would let an attacker
  /// binary-search the radius from three origins and recover the exact point,
  /// which is the trilateration attack §8.4.1 opens by describing.
  fuzzedPoint Unsupported("geography(Point,4326)")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Declared here as well as created in the migration, so the datamodel and the
  /// database agree.
  ///
  /// Without it `prisma migrate diff` reports drift — *"removed index on columns
  /// (fuzzedPoint)"* — because Prisma would generate a schema with no such index
  /// and conclude the database has one it should not. Harmless under
  /// `migrate deploy`, which is what the deploy runs, and **not** harmless under
  /// `migrate dev`, which would helpfully write a migration dropping the index
  /// BRD §4.2 requires.
  @@index([fuzzedPoint], type: Gist)
  @@map("listing_locations")
}

/// A rental transaction, from the moment a renter asks (BRD §6.2, §7, slice 4.2).
///
/// **Deliberately minimal, and the omissions are scheduled rather than
/// forgotten.** §6.2 lists totals, config versions and an expiry on this
/// entity. All three are produced by the quote (slice 4.4) and the request
/// (4.5), and columns nothing fills for two slices are columns whose meaning
/// nobody can check. Expand-and-contract is the project's migration rule and
/// this is what it looks like applied forward.
///
/// **What it does carry is what the overlap constraint needs**, because that
/// constraint is the reason this slice exists and it is the one guarantee in
/// Phase 4 that cannot be added later without a lock on a populated table.
///
/// **A binding note for slice 4.4, from the product owner on 16 August 2026:**
/// *"if the booking is done, it should show in history, all details."* So the
/// money and the item description are **copied onto this row** when a booking
/// is made, not read back through `listing` — §8.2 already requires a booking
/// to keep the terms it was made under, and history is the second reason.
/// A renter's completed booking has to render in full when the owner has
/// deleted their account and the listing has collapsed to a district.
model Booking {
  id String @id @default(uuid()) @db.Uuid

  /// What is being hired. `ON DELETE RESTRICT` — see `Listing.bookings`.
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id])

  /// Who is hiring it. `ON DELETE RESTRICT` — accounts are soft-deleted, so
  /// this never fires in production and exists to make sure it never can.
  ///
  /// **The owner is not a column here.** It is `listing.ownerId`, and
  /// duplicating it would create a row that can disagree with itself about who
  /// is owed the money. Where a *display* copy of the owner is needed for
  /// history, that is 4.4's business along with the totals.
  renterId String @db.Uuid
  renter   User   @relation(fields: [renterId], references: [id])

  /// One of §7's twenty-three states, as text with the vocabulary in code —
  /// exactly like `listings.status` and for the same reason: a Postgres enum
  /// needs a migration to add a value, and §7's table is the kind of thing that
  /// gains a row when a phase discovers one.
  ///
  /// **The database does not police which value this holds, and one part of it
  /// deliberately does**: the `EXCLUDE` constraint below is scoped by a `WHERE`
  /// over the nine calendar-occupying states of §8.5.1, so an unknown value
  /// would silently fall outside the overlap guarantee rather than erroring.
  /// `booking-state-machine.ts` is what keeps the vocabulary honest, and the db
  /// test asserts the constraint's list against it.
  state String @db.Text

  /// The hire period, in UTC (ADR 0003).
  ///
  /// **Stored as two instants and compared as a range.** `period` below is the
  /// range, and it is derived from these two rather than being the source of
  /// truth, because Prisma can read and write a `timestamptz` and cannot touch
  /// a `tstzrange` at all.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// The IANA zone the rental is counted in (ADR 0003).
  ///
  /// **Redundant today and carried anyway**, in that ADR's own words:
  /// everything is `Europe/London`, and retrofitting a zone onto historical
  /// bookings once any exist elsewhere means guessing what they meant. A
  /// rental "day" is a local calendar day, so this is what makes a two-day hire
  /// across a BST transition still two days.
  timeZone String @db.Text

  /// The period as a range, for the overlap constraint (BRD §8.5.1, ADR 0004).
  ///
  /// **The third `Unsupported` column in this schema, and the same shape as the
  /// other two** — `listing_locations.fuzzedPoint` and `listings.searchDocument`
  /// — maintained by trigger from the columns above and never written by
  /// application code. Nullable here because a *required* `Unsupported` column
  /// blocks ordinary Prisma writes on the model, which is §4.2's rule and is
  /// why all three are declared this way.
  ///
  /// **Unlike the other two, a null here would be a silent hole**, so the
  /// database refuses one: an `EXCLUDE` constraint ignores NULL, so a booking
  /// with no range would escape the overlap check entirely — the one guarantee
  /// this table exists to provide. A `CHECK` in the migration makes it
  /// impossible; it is invisible to Prisma, exactly as
  /// `location_is_geocoded_or_not` already is.
  ///
  /// **`[)` — inclusive start, exclusive end.** A hire ending at 09:00 and one
  /// starting at 09:00 do not overlap, because the item genuinely changes
  /// hands. There is **no turnaround buffer**: whether an owner needs an hour
  /// between hires is category configuration and a product decision, not a
  /// range bound quietly widened here.
  period Unsupported("tstzrange")?

  /// The quote this booking was made from (BRD §8.5.2, slice 4.5a).
  ///
  /// **`ON DELETE RESTRICT`, and this is the inversion the 17 August erasure
  /// decision predicted.** A quote nobody acted on is erased with its renter's
  /// account; a quote a booking was made from is part of that booking's terms and
  /// belongs to the *counterparty* as much as to the renter, so it cannot be
  /// deleted while the booking exists. `quotes.renterId` and `quotes.listingId`
  /// change from `CASCADE` to `RESTRICT` in the same migration for the same
  /// reason — the same shape the 10 August listing-deletion decision took when a
  /// booking started referencing a listing.
  ///
  /// **Required, not optional.** There is one way to make a booking and it starts
  /// with a price somebody was shown. A nullable column would permit a booking
  /// whose money came from nowhere provable.
  ///
  /// **`@unique` from slice 4.7a: one quote becomes at most one booking.** Without
  /// it a double-press or a second tab turned one quote into two identical
  /// `REQUESTED` rows, and §8.5.1's `EXCLUDE` constraint cannot see them — its
  /// `WHERE` covers the nine calendar-occupying states and §7.1 deliberately leaves
  /// `REQUESTED` out, so that several renters may ask for the same dates.
  ///
  /// Plain rather than scoped to live states: re-using a dead booking's quote is
  /// re-pricing, and `Quote` refuses that idea already by having no `updatedAt`.
  quoteId String @unique @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id])

  /// The configuration in force when this booking was made (BRD §6.2's *config
  /// versions*, §8.2).
  ///
  /// **The pin §8.2 requires, and ADR 0042 said would land on the booking.** The
  /// quote already stores it; copying it here rather than reading it through the
  /// quote is deliberate — the booking is the record that must still be
  /// interpretable, and one join fewer is one fewer thing that can be missing.
  categoryVersionId String          @db.Uuid
  categoryVersion   CategoryVersion @relation(fields: [categoryVersionId], references: [id])

  /// What was agreed, copied at the moment the booking was made — integer minor
  /// units with the currency on the same record (ADR 0002).
  ///
  /// **Copied rather than read back through the listing**, which is the product
  /// owner's instruction of 16 August: *"if the booking is done, it should show in
  /// history, all details"*. §8.2 requires a booking to keep the terms it was made
  /// under, and the listing is free to be repriced, paused, edited or — from the
  /// 10 August decision — collapsed to its district when its owner leaves. A
  /// booking that rendered its price by joining a listing would show today's price
  /// for last month's hire, or nothing at all.
  ///
  /// One currency column for all three, as `quotes` and `listings` both do.
  itemChargeAmount Int    @db.Integer
  renterFeeAmount  Int    @db.Integer
  totalAmount      Int    @db.Integer
  currency         String @db.Text

  /// What was hired, in the words that were on the listing at the time.
  ///
  /// **The other half of "all details".** A booking history line has to be
  /// readable — *"Petrol hedge trimmer, Outdoor and gardening, 21–23 August"* —
  /// after the listing has been retitled, recategorised or erased.
  ///
  /// **The title and the category name, not the description.** A two-thousand
  /// character description on every booking row is weight nothing renders, and the
  /// description is not part of what was agreed in the way the price and the item
  /// are. If §8.9's condition protocol later needs the description as it stood,
  /// that is evidence attached to a handover rather than a column here.
  itemTitle    String @db.Text
  categoryName String @db.Text

  /// When an unanswered request expires (BRD §8.6, §6.2's *expiry*, §7.1).
  ///
  /// Computed at creation from the category version's `requestExpiryHours`, so a
  /// deadline reconfigured later cannot move a request already made.
  ///
  /// **Named for the request rather than called `expiresAt`, deliberately.** §7
  /// reaches `EXPIRED` from three states — `REQUESTED`, `AWAITING_PAYMENT` and
  /// `PAYMENT_FAILED` — and those are different deadlines with different lengths
  /// and different owners. One column serving all of them would have to be
  /// rewritten on every transition, which is how a payment deadline comes to
  /// expire a booking as though nobody had answered it. Phase 5's payment window
  /// gets its own column.
  ///
  /// It is **not cleared on acceptance**: it records what the deadline was, and
  /// 4.7's worker acts only on bookings still in `REQUESTED`.
  requestExpiresAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// This booking's state history (BRD §6.2). Append-only — see `BookingEvent`.
  events BookingEvent[]

  /// Money posted against this hire (slice 5.1). Declared because Prisma requires
  /// both ends; Booking never reads it — BRD §5.1 gives Payments & Ledger the
  /// money and forbids Booking *"provider-specific payment code"*, so the traffic
  /// runs the other way.
  ledgerTransactions LedgerTransaction[]

  /// Attempts at taking money for this hire (slice 5.2b). Declared for the same
  /// reason as the relation above and read by nobody on this side.
  paymentIntents PaymentIntent[]

  /// Both dashboards in slice 4.8 read one side's bookings, newest first.
  @@index([renterId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  /// What 4.7's expiry worker asks: which requests have run out of time. The
  /// state is first because it is the more selective of the two — most bookings
  /// are not awaiting an answer.
  @@index([state, requestExpiresAt])
  /// Declared so the datamodel and the database agree — the same note
  /// `listings.searchDocument` and `listing_locations.fuzzedPoint` carry. The
  /// `EXCLUDE` constraint creates an index of its own that Prisma cannot see;
  /// this one is what `migrate diff` compares against.
  @@index([period], type: Gist)
  @@map("bookings")
}

/// A period an owner has declared their item unavailable (BRD §8.5, slice 4.3a).
///
/// §8.5: *"Owner calendar supports available, unavailable and booked periods."*
/// **Booked is `bookings`; this is unavailable; available is the absence of
/// both.** Three concepts, two tables and a subtraction — rather than one table
/// with a kind column, which would have put an owner's holiday and a renter's
/// money in the same rows and made every query about either of them start by
/// remembering which it wanted.
///
/// **In the booking module, not catalogue** (BRD §5.1). An owner reaches this
/// from their listing, so the instinct is to file it with listings — but what it
/// *means* is a booking question, it needs the same `tstzrange` machinery the
/// overlap constraint needs, and keeping ranges in one module means one place in
/// this system understands them.
///
/// **No `EXCLUDE` constraint, and that is deliberate.** Two overlapping blocks
/// are harmless — an owner who blocks a fortnight and then blocks a week inside
/// it has said the same thing twice, and refusing the second would be a form
/// error about nothing. What must not overlap is two *bookings*, which is
/// `bookings`' constraint and stays there.
model AvailabilityBlock {
  id String @id @default(uuid()) @db.Uuid

  /// `ON DELETE CASCADE`, which is the opposite of `bookings.listingId` and the
  /// difference is who the row belongs to. A booking is a record of a
  /// transaction between two people and outlives the listing (§10.1); a block is
  /// the owner's own note about their own item, so when the listing goes it goes
  /// — there is nobody else whose record it is.
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// The range, maintained by trigger — `bookings.period`'s shape and reasons,
  /// including `[)` so a block ending Friday and a hire starting Friday do not
  /// collide.
  period Unsupported("tstzrange")?

  /// What the owner called it, or null.
  ///
  /// **Their own words and shown to nobody else.** A renter is told a period is
  /// unavailable and never why — "away", "lent to my brother" and "servicing"
  /// are all somebody's private business, and a free-text field that reached a
  /// stranger is the kind of disclosure §10.1 exists to prevent. It is here
  /// because a calendar of unexplained grey blocks is one an owner cannot
  /// manage after a month.
  reason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// The calendar reads one listing's blocks in date order.
  @@index([listingId, startAt])
  /// Declared so the datamodel and the database agree — the note on
  /// `bookings.period` and `listings.searchDocument` applies here too.
  @@index([period], type: Gist)
  /// What ADR 0049's dated search resolves through (slice 4.9a).
  ///
  /// The composite `bookings` gets for free from §8.5.1's `EXCLUDE` constraint,
  /// which this table has no equivalent of — an `EXCLUDE` cannot span two
  /// tables, so the overlap with a booking is checked in application code and
  /// the index never arrived with it. Without this the search's anti-join
  /// seq-scanned the table once per candidate listing: p95 1945 ms against a
  /// 200 ms target, 207 ms with it.
  ///
  /// `[period]` above is **not** redundant with this one and both are kept: a
  /// GiST index cannot be scanned on a trailing column alone, so a lookup by
  /// period without a listing id would not reach this.
  ///
  /// **`gist_uuid_ops` is required and comes from `btree_gist`.** GiST has no
  /// default operator class for `Uuid`, so without the `ops` the schema does not
  /// parse at all — `P1012`, not drift. The extension is installed everywhere
  /// and `pnpm db:verify` asserts it; it is the same one §8.5.1's `EXCLUDE`
  /// constraint on `bookings` depends on.
  @@index([listingId(ops: raw("gist_uuid_ops")), period], type: Gist)
  @@map("availability_blocks")
}

/// One thing that happened to a booking (BRD §6.2, §7, slice 4.5a).
///
/// §6.2 calls this an **immutable state history**: *"Event type, actor, timestamp,
/// metadata"*. §7 requires transitions to be validated centrally and never
/// invented by a button; this is the record that they were.
///
/// **Why it exists at all, when `audit_logs` is right there.** The audit log
/// answers *"who did what to whom"* across the whole platform and is read by an
/// administrator and by the subject of an action. This answers *"what has happened
/// to this booking"* and is read by the two parties to it, in order, as a history.
/// Putting booking states in the audit log would mean either exposing an
/// administrative projection to members or filtering it per reader — and the audit
/// log deliberately has no update method and no notion of sequence within one
/// subject.
///
/// **It was deferred from 4.2 to here on purpose**, by the product owner on
/// 16 August: nothing transitioned until now, and a table with no writer is a dead
/// control. 4.5a is the first writer.
///
/// **Append-only, and the database enforces it** — a trigger refuses `UPDATE`,
/// exactly as `category_versions`' does. That is a stronger guarantee than the
/// audit log has (a port with no update method, which is code rather than
/// storage), and it is warranted because §6.2 uses the word immutable and because
/// a state history that can be edited is evidence of nothing. `DELETE` is left
/// alone for the same reason it is on `category_versions`: retention (§10.1) is a
/// scheduled act, not an application one.
model BookingEvent {
  id String @id @default(uuid()) @db.Uuid

  /// `ON DELETE CASCADE`. A booking's history is meaningless without the booking,
  /// and bookings are never deleted in the ordinary course — §10.1 retains booking
  /// records for six years, and an account that leaves is soft-deleted so its
  /// bookings survive with a tombstoned counterparty.
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// What happened, from a closed vocabulary in code (`BookingEventType`).
  ///
  /// Text with the vocabulary in code rather than a Postgres enum, for the reason
  /// `bookings.state` and `listings.status` both give: a Postgres enum needs a
  /// migration to add a value, and §7's vocabulary is exactly the kind of thing a
  /// phase discovers a new member of.
  type String @db.Text

  /// The transition this event records, or nulls for an event that is not one.
  ///
  /// **`fromState` is null on creation** — a booking's first event has nothing to
  /// come from, and writing `DRAFT` there would assert a state it was never in.
  /// Both are null for an event that says something happened without moving the
  /// booking, which §6.2's "event type" permits and 4.6's auto-decline notice will
  /// use.
  fromState String? @db.Text
  toState   String? @db.Text

  /// Who caused it, or **null for the platform itself**.
  ///
  /// Null is not missing data: an expiry sweep (4.7) and an auto-decline (§7.1,
  /// 4.6) have no human actor, and recording one would be a lie about who decided.
  /// `ON DELETE RESTRICT` — accounts are soft-deleted, so this never fires and
  /// exists to make sure it never can.
  ///
  /// **`Restrict` is stated rather than left to Prisma's default**, which for an
  /// optional relation is `SetNull` — and that would quietly rewrite history to
  /// say *the platform* did something a person did. It is the same latent defect
  /// `listings.moderatedById` carries today, found by reading this diff.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Anything else worth keeping about this event, as JSON (§6.2's *metadata*).
  ///
  /// **Empty by default rather than nullable.** `{}` and null would mean the same
  /// thing to every reader while needing two branches at each one — the call
  /// `category_versions.attributes` already made.
  ///
  /// **Nothing personal goes in here.** It is the loosest column in the booking
  /// tables and therefore the one most likely to accumulate a postcode or a note
  /// somebody typed; what belongs is what a state change needs to be understood —
  /// a refusal reason, the id of a conflicting request — and §10.1's erasure has no
  /// way to reach inside a JSON blob.
  metadata Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **No `updatedAt`.** Nothing updates an event, and the trigger refuses it.
  ///
  /// The history of one booking, oldest first — which is how it is read, and the
  /// opposite of every other index in these tables. `createdAt` alone ties for two
  /// events written in the same millisecond, so `id` breaks it: the same tiebreak
  /// Phase 3's `ORDER BY` needed and that session 37's flake taught.
  @@index([bookingId, createdAt, id])
  @@map("booking_events")
}

/// A priced, expiring offer for a period (BRD §8.5.2, §6.2, slice 4.4b).
///
/// **Why a quote is stored at all, when the price could be recomputed.** §8.5.2:
/// *"The renter postcode used is stored on the `Quote` record so the quote can be
/// reproduced and audited"*, and *"Every quote has an expiry and stores the
/// pricing-rule and category version"*. A price we showed somebody is a thing we
/// said, and recomputing it later answers a different question — what we would
/// say now — which is exactly the question a dispute is not about.
///
/// **In the booking module** (BRD §5.1), like `availability_blocks` and for the
/// same reason: the arithmetic lives in `pricing/`, which has no store and no
/// ports by design (ADR 0034), and what a quote *is* — an offer for dates on a
/// listing — is Booking's subject.
///
/// **It has a renter, which §6.2's entity list does not.** That list names the
/// renter's *postcode* but no renter, which taken literally would let an
/// anonymous visitor leave a postcode and a date range in this table with no
/// subject who could ask for it back — personal data with no erasure route,
/// against §10.1. So a quote requires a signed-in renter. Nothing is lost: a
/// stranger still sees the indicative `from £x/day` the listing page shows, which
/// §8.5.2 explicitly permits before a postcode is supplied.
///
/// **Nothing here is immutable by trigger, unlike `category_versions`.** A quote
/// is not configuration that other rows point at — it expires, and 4.5 will copy
/// what it needs onto the booking rather than referencing it for meaning. What
/// makes it trustworthy is that nothing updates it: there is no route that
/// re-prices a quote, because re-pricing is issuing a new one.
model Quote {
  id String @id @default(uuid()) @db.Uuid

  /// What was priced. `ON DELETE CASCADE` — the same call
  /// `availability_blocks.listingId` makes, and the opposite of
  /// `bookings.listingId`. A quote nobody acted on is not a record of a
  /// transaction between two people; it is a price we offered for an item, and
  /// when the item goes the offer means nothing.
  ///
  /// **It stays `CASCADE`, and 4.5a nearly changed it by symmetry with `renterId`
  /// below — which would have broken account erasure.** The two ends of this table
  /// genuinely differ:
  ///
  /// A listing is only ever deleted when **nothing has booked it**
  /// (`listings.eraseOwnedBy`), so every quote hanging off a deletable listing is
  /// an unbooked quote — a price offered for an item that is going. And if a
  /// *booked* quote somehow referenced it, `bookings.quoteId`'s `RESTRICT` would
  /// refuse the whole delete, which is the guard that actually protects the terms.
  ///
  /// `RESTRICT` here would instead have meant that **an owner could not erase their
  /// account once a stranger had asked their listing for a price** — a §10.1
  /// failure triggered by somebody else's action. Slice 4.4b's own db test caught
  /// it.
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Who asked. `ON DELETE CASCADE`, deliberately, and it is the erasure
  /// decision of 17 August 2026 in one column: *an unused quote is erased
  /// outright, and a quote a booking references follows the booking.*
  ///
  /// **It was `CASCADE` in 4.4b and is `RESTRICT` from 4.5a**, which is the
  /// inversion that decision predicted and 4.2 had already performed once when
  /// `deleteAllOwnedBy` became `eraseOwnedBy`. Now that a booking can reference a
  /// quote, the erasure is conditional rather than wholesale:
  /// `QuotesService.eraseFor` deletes the quotes **nothing has booked** and leaves
  /// the rest, because accounts are soft-deleted (ADR 0018) and the *counterparty*
  /// keeps a right to the terms they agreed to. The `RESTRICT` is what makes a
  /// mistake here a failed delete rather than a silently destroyed record.
  renterId String @db.Uuid
  renter   User   @relation(fields: [renterId], references: [id])

  /// The hire the price is for, in UTC (ADR 0003), `[startAt, endAt)`.
  ///
  /// **No `period` range and no exclusion constraint**, unlike `bookings` and
  /// `availability_blocks`. A quote reserves nothing (§7.1) — two people may hold
  /// quotes for the same week, and only 4.6's acceptance decides between them.
  /// Giving this table a range would suggest otherwise.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// The zone the hire was counted in (ADR 0003), stored for the reason that ADR
  /// gives: a period priced today must still recount the same way in five years.
  timeZone String @db.Text

  /// The renter's postcode, normalised (§8.5.2).
  ///
  /// **Required, stored, and it does not change the price today.** §8.5.2 makes
  /// it a quote input because location determines reachability, whether owner
  /// delivery is available and at what charge, and any location-dependent fee
  /// configuration — none of which exists as configuration yet. It is collected
  /// now because a quote without it *"must not be presented as a firm total"*,
  /// and because collecting it later would mean re-quoting every price already
  /// given.
  ///
  /// **In the clear, unlike `listing_locations.postcode`.** The encrypted one is
  /// somebody's home address, disclosed only after a booking; this is an
  /// answer to *"where are you"* volunteered to get a price, and it has to be
  /// readable by the query that will one day compute a delivery charge from it.
  /// It is personal data all the same, which is what the cascade above is for.
  renterPostcode String @db.Text

  /// What the owner charges, the renter's mandatory fee, and the headline total —
  /// integer minor units with the currency on the same record (ADR 0002).
  ///
  /// **One currency column for all three**, as `listings.rateCurrency` does: a
  /// quote whose fee is in a different currency from its item charge is not a
  /// quote, and three columns would make that expressible.
  ///
  /// **`total` is stored rather than derived**, which is the one piece of
  /// redundancy here and is deliberate: it is the number a person was shown, and
  /// §3.4.4 makes it the legally significant one. A total recomputed from the
  /// parts by a later reader would silently adopt that reader's rounding.
  itemChargeAmount Int    @db.Integer
  renterFeeAmount  Int    @db.Integer
  totalAmount      Int    @db.Integer
  currency         String @db.Text

  /// Whether the category's minimum platform fee bound rather than the
  /// percentage, carried so a price can be explained without re-deriving it.
  minimumFeeApplied Boolean @db.Boolean

  /// The units the price was built from — `[{ unit, count, unitPrice, subtotal }]`
  /// (§6.2's *line items*).
  ///
  /// **JSON rather than a child table**, which is `category_versions.attributes`'
  /// reasoning: it is variable-length, ordered, always read whole, and never
  /// queried across rows. A `quote_line_items` table would add a join to every
  /// read of a row that is meaningless without it.
  ///
  /// It is what makes a price explainable a year later — *"one week and three
  /// days at the rates in force"* — which is the property the pricing rule was
  /// chosen for (ADR 0047).
  lineItems Json @db.JsonB

  /// The category version whose fee policy priced this (§8.5.2's *category
  /// version*).
  ///
  /// **ADR 0042 says a listing reads the *current* fee policy and that the pin
  /// happens when a commitment is made — and puts that pin in Phase 5.** It
  /// arrives here instead, because a quote is already a commitment: it is a firm
  /// total with an expiry, and reproducing it needs the rates it was computed
  /// from. `ON DELETE RESTRICT`, so configuration a price was given under cannot
  /// be deleted out from under it.
  categoryVersionId String          @db.Uuid
  categoryVersion   CategoryVersion @relation(fields: [categoryVersionId], references: [id])

  /// When the price stops holding (§8.5.2 requires an expiry and does not say
  /// what it should be — `QUOTE_VALIDITY_MINUTES` names the 30 minutes and why).
  ///
  /// **Enforced by reading, not by deletion.** An expired quote stays until
  /// erasure or a retention sweep collects it, because it is evidence of what was
  /// offered; what expires is its usability, and 4.5 is what refuses to build a
  /// booking on one.
  expiresAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// **No `updatedAt`, deliberately.** Nothing updates a quote. Re-pricing is a
  /// new quote, and a column suggesting otherwise would be an invitation.
  ///
  /// A renter reads their own quotes newest first; the listing index is what a
  /// retention sweep and 4.5's lookup both use.
  /// The booking made from this quote, if one was (slice 4.5a). At most one —
  /// there is one way to make a booking and it consumes a quote once. Declared
  /// because Prisma requires both ends, and because it is what makes "has this
  /// quote been booked" answerable by the conditional erasure.
  bookings Booking[]

  @@index([renterId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("quotes")
}

/// A seller's tax position for statutory reporting — **present and inactive**.
///
/// BRD §14 requires this entity from Phase 1 and §8.14.2 says why: *"the Seller
/// tax profile entity and the reporting export exist in the data model from the
/// outset but are inactive while all categories are flagged `none`. This keeps
/// the obligation a configuration switch, not a rebuild."*
///
/// **Nothing writes here, and no application code reads it.** There is no port,
/// no service and no route. That is the specified state, not an oversight: every
/// category is `none` (§8.14.1 — rental of general goods is not a Relevant
/// Activity), so there is no lawful basis to collect any of this and no
/// obligation to.
///
/// **It deliberately has no personal-data columns yet**, though §6.2 lists
/// "collected fields". Those fields are a name, an address, a date of birth and
/// a taxpayer reference — personal data, which in this codebase means a table
/// that `PersonalDataEraser` erases and the two `PersonalDataSource`
/// projections expose. Nothing enumerates the tables that hold personal data, so
/// a fourth one added now would silently be absent from erasure and from the
/// export, and would stay absent until somebody noticed. The columns arrive with
/// the collection flow that needs them, together with their erasure — expand and
/// contract, and the expand step waits for a reader.
///
/// **No module owns it.** BRD §5.1 names no owner, and it has no behaviour to
/// place. When it activates the likely home is Payments & Ledger, because what
/// gets reported is the consideration paid to a seller — but that is a decision
/// for the slice that builds collection, not one to guess at here.
model SellerTaxProfile {
  id String @id @default(uuid()) @db.Uuid

  /// One profile per seller. Keyed on the platform `users.id`, never on the
  /// identity provider's subject — ADR 0015's rule, and the reason this survives
  /// changing provider.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation, and the
  /// right one twice over: accounts are soft-deleted so it never fires, and a
  /// statutory record that a deletion could take with it would be the wrong
  /// shape for something retained against a filing deadline.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Which reporting regime applies — `uk_dprr` today, and nothing else.
  ///
  /// A regime rather than the reportable-activity head, because a seller can be
  /// active in two reportable categories at once and would then need two
  /// profiles under one obligation. The head lives on the category version,
  /// where it belongs; this says whose rules the resulting return is filed
  /// under, which is what §6.2 means by "applicable reporting regime".
  ///
  /// **No default.** One value exists today, so a default would be free — and it
  /// would mean the first code to write a row could do so without deciding
  /// anything, which is the failure ADR 0025 describes. A `CHECK` pins the
  /// vocabulary; see the migration.
  regime String @db.Text

  /// `not_started`, `pending`, `verified` or `failed` (§6.2, "verification
  /// state"). Also `CHECK`ed rather than left to code, because there is no code:
  /// until this activates, the constraint is the only thing that can refuse a
  /// value nobody meant.
  ///
  /// Provisional by design. Nothing has been built against it, and no row
  /// exists, so widening the vocabulary costs a migration on an empty table.
  verificationState String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("seller_tax_profiles")
}

/// A feature flag that has been switched away from its declared default.
///
/// **The table holds overrides, not flags** (ADR 0036, slice H3a). The set of
/// flags is a closed vocabulary declared in code, because a flag key gates a
/// code path and code paths are code — a key an administrator invented would
/// gate nothing, which is a dead control with a database row behind it. A key
/// with no row here is not "off": it is at whatever default its declaration
/// gives it.
///
/// Two consequences, both deliberate. **Adding a flag needs no migration** — it
/// is a line in the declaration. And **the default survives this table being
/// unreadable**, which is the property that matters: a default stored in the row
/// you cannot read is not a default, and a database blip must not silently flip
/// behaviour.
///
/// **Not versioned, and that is the decision ADR 0036 records.** Category
/// configuration is versioned because §8.2 requires a booking to retain the
/// version it was made under — a booking *pins* a version. Nothing pins a flag:
/// it decides whether a code path runs at the instant it runs, and no entity
/// needs to remember its value afterwards. Version rows would add a table and a
/// trigger for no invariant, and would make a kill switch slower to operate in
/// exactly the incident it exists for. Who changed it, when and why is the audit
/// trail's job (§8.13), and every write here records one.
model FeatureFlagOverride {
  /// A synthetic identity, and it exists for one reason: `audit_logs.targetId`
  /// is a `uuid` column, so an audited entity has to have one.
  ///
  /// `key` is a perfectly good natural key and would otherwise be the primary
  /// key. It is unique instead, which keeps the guarantee that matters — one
  /// flag has exactly one state — while giving the audit trail something of the
  /// shape it requires. Every other audited entity in the system is in the same
  /// position: `category.created` records a category's uuid rather than its
  /// slug, so this is the established shape rather than a concession invented
  /// here.
  id String @id @default(uuid()) @db.Uuid

  /// The declared key, e.g. `listing.publication`.
  ///
  /// Unique, because one flag has one state — a second row for the same key
  /// would be two answers to a question that must have one, and the evaluator
  /// would have to pick between them.
  key String @unique @db.Text

  /// What the flag is, against its declared default.
  enabled Boolean

  /// Who switched it last, and when. Not an audit substitute — the trail holds
  /// the reason and the before/after — but the administrator looking at the
  /// list needs to see it without leaving the page, and an incident asks "when
  /// did this change" before it asks anything else.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation: accounts
  /// are soft-deleted so it never fires, and an override that vanished with its
  /// author would leave the platform in a state nobody appeared to have chosen.
  changedById String @db.Uuid
  changedBy   User   @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("feature_flag_overrides")
}

/// One account in the platform's own chart of accounts (BRD §8.7, slice 5.1).
///
/// **The ledger is the accounting record and the provider is only the channel
/// that executed it** — BRD §4: *"The platform database must never treat a
/// payment-provider webhook alone as the accounting record."* Nothing on this
/// table names a provider, and that is deliberate: it is what makes changing
/// provider a change of adapter rather than a rewrite of the books.
model LedgerAccount {
  id String @id @default(uuid()) @db.Uuid

  /// One of `LEDGER_ACCOUNT_KINDS`, as text with the vocabulary in code — the
  /// same call `bookings.state` makes, and for the same reason: a chart of
  /// accounts gains rows as flows arrive, and a Postgres enum needs a migration
  /// to gain one.
  kind String @db.Text

  /// Whose money this is, for the per-person kinds. Null for the platform's own.
  ///
  /// `ON DELETE RESTRICT`, and here that is load-bearing rather than defensive:
  /// ADR 0015 soft-deletes accounts precisely so *"the ledger will reference
  /// these rows and can never lose a counterparty"*. A ledger that cannot say
  /// who it owes is not a ledger.
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  /// ISO 4217, beside the amounts it denominates (ADR 0002).
  currency String @db.Text

  /// The account's natural identity — `provider_clearing:GBP`, or
  /// `owner_payable:<userId>:GBP` — derived once by `accountIdentityOf`.
  ///
  /// **A single unique column rather than `@@unique([kind, ownerId, currency])`,
  /// and the reason is NULL.** Postgres treats NULLs as distinct in a unique
  /// index, so the composite would let the platform hold *two*
  /// `provider_clearing` accounts in GBP and silently split a balance across
  /// them. `NULLS NOT DISTINCT` would fix it and Prisma cannot express it, which
  /// would put the real guarantee in raw SQL the schema does not know about.
  ///
  /// It also buys the operation the store actually needs: "the account for this
  /// kind and this person, creating it if absent" is a single `upsert` on one
  /// unique column, which is race-safe. The composite form is not upsertable in
  /// Prisma at all when part of it is null.
  identity String @unique @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  entries LedgerEntry[]

  /// The target of `ledger_entries`' composite foreign key. See `LedgerEntry`.
  @@unique([id, currency])
  @@index([ownerId])
  @@map("ledger_accounts")
}

/// A balanced set of movements, posted as one act (BRD §8.7, slice 5.1).
///
/// **Immutable, and the database enforces it** — a trigger refuses both UPDATE
/// and DELETE. §8.7: *"Ledger entries are immutable; corrections are made only
/// by posting reversing entries, never by editing or deleting."* That is
/// stricter than `booking_events`, which refuses UPDATE and permits DELETE for
/// retention, and the difference is deliberate: §8.7 names deleting.
model LedgerTransaction {
  id String @id @default(uuid()) @db.Uuid

  /// What makes posting this twice a no-op rather than a duplicate.
  ///
  /// §11.2's gate is *"duplicate and out-of-order provider webhooks produce
  /// exactly one ledger effect"*. Unique here, so the guarantee is the
  /// database's — a check-then-write loses the race that this exists to stop.
  idempotencyKey String @unique @db.Text

  /// One of `LEDGER_TRANSACTION_KINDS`. A correction is **not** a kind — it
  /// keeps the kind of what it reverses and is identified by `reversesId`.
  kind String @db.Text

  currency String @db.Text

  /// The hire this concerns, where there is one (§6.2 lists `booking` on the
  /// entry). `ON DELETE RESTRICT`: a booking with money against it cannot go.
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  /// When the money moved, by the provider's clock.
  ///
  /// **Separate from `recordedAt` because reconciliation is daily** (§8.7) and
  /// the provider's day is the one that decides which day a movement belongs to.
  /// One timestamp would put a capture just before midnight on our side of the
  /// boundary and their other side, and break reconciliation every night for no
  /// reason anybody could find.
  occurredAt DateTime @db.Timestamptz(3)

  /// When we wrote it down.
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Set only on a correction, naming what it reverses.
  ///
  /// **Unique, so a transaction can be reversed at most once.** Without it a
  /// double-click posts two corrections and the original is undone twice, which
  /// nets to reversing a transaction that never happened. Reversing a *reversal*
  /// is still legal and is how a mistaken correction is undone — it points at
  /// the correction, not at the original.
  reversesId String?            @unique @db.Uuid
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")

  entries LedgerEntry[]

  /// The target of `ledger_entries`' composite foreign key. See `LedgerEntry`.
  @@unique([id, currency])
  @@index([bookingId])
  @@index([occurredAt])
  @@map("ledger_transactions")
}

/// One side of one movement (BRD §6.2 *Ledger entry*, slice 5.1).
///
/// **The currency is stored here as well as on the transaction and the account,
/// and the duplication is enforced rather than trusted.** CLAUDE.md's money
/// invariant requires *"integer minor units plus an ISO 4217 currency code on
/// the same record"*, so an entry that had to join to learn its own currency
/// would break it. Three copies could disagree — so both foreign keys are
/// **composite on `(id, currency)`**, which makes an entry whose currency
/// differs from its transaction's or its account's unrepresentable rather than
/// merely wrong. A `CHECK` cannot span tables; a foreign key can.
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  currency String @db.Text

  transactionId String            @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict)

  accountId String        @db.Uuid
  account   LedgerAccount @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)

  /// `debit` or `credit`, and a `CHECK` holds it to those two.
  ///
  /// **Unlike `bookings.state`, this vocabulary can never grow**, which is what
  /// makes a database constraint the right tool here and the wrong one there.
  direction String @db.Text

  /// Integer minor units, **strictly positive** — a `CHECK` refuses zero and
  /// negative. ADR 0002 permits negative `Money` for refunds, and a ledger entry
  /// is where that permission stops: the direction already carries the sign, and
  /// admitting both conventions makes every later sum ambiguous.
  amountMinor Int

  /// Balances are read per account, and a correction is read per transaction.
  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// One attempt at moving money through a payment provider (BRD §6.2, §8.7,
/// slice 5.2b).
///
/// **Mutable, where the ledger beside it is not**, and the difference is the
/// reason this table exists. The ledger records what *happened* and §8.7 makes
/// it permanent; this records what is *happening* at somebody else's system,
/// which changes — under SCA an attempt begins as a challenge in a browser and
/// becomes an outcome minutes later, by webhook.
///
/// **No provider identifier is a key** (ADR 0051). `provider` and
/// `providerReference` together are the mapping row that ADR requires, so a row
/// written under Stripe stays readable after a move and nothing joins on it.
///
/// **No card data, ever** (§8.7). There is no column here that could hold one.
model PaymentIntent {
  id String @id @default(uuid()) @db.Uuid

  /// The hire this pays for. `ON DELETE RESTRICT` — the reason
  /// `LedgerTransaction.booking` gives: a record of money moved cannot lose its
  /// subject.
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  /// Who is owed the proceeds, and the category version whose fee policy divides
  /// them (§8.2, slice 5.2b).
  ///
  /// **Copied onto this row rather than joined to, and the reason is the webhook.**
  /// An attempt's outcome usually arrives out of band — a 3-D Secure challenge
  /// finishes minutes later and the confirmation carries a provider reference and
  /// nothing else. Whatever handles that has no booking in hand, and Payments may
  /// not read `bookings` (BRD §5.1). So the row carries what it takes to settle.
  ///
  /// Both `ON DELETE RESTRICT`: a payee we cannot name is a payment we cannot
  /// make, and `category_versions` is immutable so the rate is provable years
  /// later.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  categoryVersionId String          @db.Uuid
  categoryVersion   CategoryVersion @relation(fields: [categoryVersionId], references: [id], onDelete: Restrict)

  /// What this attempt is for — one of `PAYMENT_INTENT_PURPOSES`.
  ///
  /// **One value today, `hire_charge`.** §8.7.2's damage-security hold is the
  /// second, and it arrives with the flow that writes it rather than in
  /// anticipation of one — the rule slice 5.1 set for ledger account kinds.
  purpose String @db.Text

  /// What makes a double-pressed pay button one charge.
  ///
  /// **Per attempt, not per booking.** A renter whose card was declined is
  /// entitled to try again, and that retry is a new attempt with a new key —
  /// reusing the first would return the first failure forever. **The ledger's
  /// idempotency key is the per-booking one**, and conflating the two is how a
  /// retry becomes unpayable.
  attemptKey String @unique @db.Text

  /// Where the attempt has got to — one of `PAYMENT_INTENT_STATUSES`.
  ///
  /// **Text with the vocabulary in code and no `CHECK`**, unlike
  /// `ledger_entries.direction`. That constraint was justified by a vocabulary
  /// that can never grow; this one can. §8.7 already names expired
  /// authorisations and chargebacks, which are values a later slice adds.
  status String @db.Text

  /// Who executed it — `PaymentProvider.name`.
  ///
  /// Stored rather than inferred, so a row written under one provider is still
  /// readable after we have moved to another. `webhook_events.provider` makes
  /// the same call.
  provider String @db.Text

  /// The provider's identifier for this attempt, once there is one.
  ///
  /// **Null until the provider has been called**, because the row is written
  /// first — a crash between the write and the call must leave a record rather
  /// than an untraceable charge. A `CHECK` requires it once `status` is
  /// `succeeded`, which is when reconciliation needs something to match.
  providerReference String? @db.Text

  /// The charge and its two parts, in integer minor units with the ISO 4217 code
  /// on the same record (ADR 0002).
  ///
  /// **A `CHECK` requires the total to be its parts**, so a row that disagrees
  /// with itself is unrepresentable — `settleHire` refuses one for the same
  /// reason, and this is that rule one layer down. The item charge is positive;
  /// the renter fee may be zero, because fees are versioned configuration and a
  /// category may be run at cost.
  ///
  /// **`NOT NULL`, and §8.7.2's damage-security hold will need them relaxed** —
  /// a hold has an owner and a version but does not divide. That is a reviewed
  /// migration, which is the right cost for a table holding money.
  itemChargeMinor Int
  renterFeeMinor  Int
  amountMinor     Int
  currency        String @db.Text

  /// When the provider's authorisation expires — its **real timestamp**
  /// (`capture_before`), never a duration we assume (§8.7.2, normative).
  ///
  /// **Null for a hire charge**, which is captured outright and holds nothing.
  /// It exists now because §6.2 names it as part of what this entity is; it is
  /// first written by §8.7.2's damage-security flow.
  authorisationExpiresAt DateTime? @db.Timestamptz(3)

  /// Why it failed, in **our** vocabulary rather than the provider's, and a
  /// sentence for the payer. A `CHECK` requires the reason once `status` is
  /// `failed`, because §8.7 requires clear failure and retry states and
  /// "something went wrong" is not one.
  ///
  /// **`failureMessage` reaches a page**, so it carries no provider name, no
  /// code and nothing about a card — `PaymentFailure` says so at the port.
  failureReason  String? @db.Text
  failureMessage String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// A booking's attempts, and the sweep that will look for stale ones.
  ///
  /// **The rule that matters is not expressible here**: at most one *succeeded*
  /// intent per booking and purpose, as a partial unique index in the migration.
  /// §8.7.1 permits only one capture per authorisation, and that index is where
  /// a double capture becomes unrepresentable.
  @@index([bookingId])
  @@index([status])
  @@map("payment_intents")
}
