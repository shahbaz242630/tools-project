// The database schema. Migrations in ./migrations are the source of truth for
// what is actually deployed; this file describes the shape they build up to.
//
// Prisma 7 notes, all of which differ from most documentation still in
// circulation (see ADR 0014):
//   - `url` is not permitted here. Connection settings live in prisma.config.ts.
//   - The client requires a driver adapter; ours is @prisma/adapter-pg.
//   - The generator emits TypeScript source, not compiled JavaScript.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// Platform roles.
///
/// Coarse by design. Ownership — "is this your listing, your booking" — is a
/// row-level question answered by the data, not by a role, and conflating the
/// two produces roles like `OWNER` that multiply per entity. BRD §6 gives one
/// account both renter and owner capabilities, so neither is a role here.
enum UserRole {
  USER
  ADMIN
}

/// A platform account.
///
/// The internal `id` is the authoritative platform identity (BRD §6). Identity
/// and payment provider IDs are stored as references against it in later
/// phases, never as the primary key — a provider that deletes an account, or
/// that we stop using, must not take the identity with it.
///
/// Since ADR 0015 this row is a **mirror**: Clerk holds the credentials and is
/// the source of truth for the identity, while this row is the thing listings,
/// bookings, messages and the ledger point at. That split is the entire reason
/// `clerkUserId` is an ordinary column and not the primary key.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Clerk's `user_…` identifier. A reference, never an identity — see the note
  /// above. Unique because two platform accounts mirroring one Clerk user would
  /// make "who is this request" ambiguous at exactly the point it must not be.
  clerkUserId String @unique @db.Text

  /// citext, so `Alice@Example.com` and `alice@example.com` are one account.
  /// Case folding in application code would leave the database able to hold
  /// both, and the uniqueness guarantee has to be the database's.
  ///
  /// Mirrored from Clerk's primary email address. On deletion it is replaced
  /// with a tombstone rather than kept — see `deletedAt`.
  email String @unique @db.Citext

  role UserRole @default(USER)

  /// Soft deletion, because hard deletion is not available to us: from Phase 2
  /// onward listings, bookings and immutable ledger entries reference this row,
  /// and the ledger in particular can never lose its counterparty.
  ///
  /// When Clerk reports a user deleted we set this *and* overwrite `email` with
  /// a tombstone at `.invalid` (RFC 2606, so it can never collide with a real
  /// address). That frees the address for genuine re-registration, which a
  /// retained unique row would otherwise block forever, and it removes the
  /// personal data we no longer have a purpose for. Full erasure semantics are
  /// a later slice — BRD §14 Phase 1 asks only for a deletion *skeleton*.
  deletedAt DateTime? @db.Timestamptz(3)

  /// When the person asked to be deleted, as distinct from when we acted on it.
  ///
  /// Two columns rather than one because they answer different questions and
  /// will diverge. `deletedAt` is the state the guard checks; this is the
  /// *request*, which is what a data-protection enquiry asks about — "when did
  /// they ask, and how long did you take". They are set together today because
  /// there is no grace period; a later slice that adds one would leave this set
  /// and `deletedAt` null for the duration, and nothing above has to change.
  deletionRequestedAt DateTime? @db.Timestamptz(3)

  /// When the account was suspended, or null if it is not.
  ///
  /// **Distinct from deletion in every way that matters.** Deletion is the
  /// person's own request and erases their data (ADR 0018); suspension is done
  /// *to* them by an administrator, is reversible, and destroys nothing. A
  /// suspended account can still sign in — it must, because UK GDPR access and
  /// erasure rights do not lapse because somebody was suspended, and an account
  /// that cannot authenticate cannot exercise them (ADR 0024).
  ///
  /// BRD §5.1 gives suspension to Trust & Safety, which does not exist yet.
  /// This is the mechanism that module will eventually drive; §14 Phase 1 asks
  /// for the skeleton and the policy comes later.
  suspendedAt DateTime? @db.Timestamptz(3)

  /// Which administrator did it.
  ///
  /// ON DELETE SET NULL rather than RESTRICT: losing who suspended somebody is
  /// bad, but the audit trail holds that permanently and it must not be
  /// possible for an old suspension to block an account removal. The same
  /// trade the audit log's actor makes.
  suspendedById String? @db.Uuid
  suspendedBy   User?   @relation("SuspendedAccounts", fields: [suspendedById], references: [id])

  /// Why, in the administrator's own words.
  ///
  /// **Shown to the suspended person**, which is deliberate and is the same
  /// bargain ADR 0021 struck for administrative reads: an administrator writing
  /// a reason knows who will read it, and that is what makes it a real control
  /// rather than a box to clear. It also means a suspension reason must be
  /// something you would be willing to say to the person's face, which is the
  /// right constraint on it.
  suspensionReason String? @db.Text

  /// Accounts this administrator suspended. Declared because Prisma requires
  /// both ends of a relation, not so anything reads suspensions through a user.
  suspendedAccounts User[] @relation("SuspendedAccounts")

  /// Stored UTC. Rendering and rental-period arithmetic happen in the booking's
  /// stored IANA timezone (BRD §6.1), never in the database.
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Present only because Prisma requires both ends of a relation to be
  /// declared. **Not** an invitation for the identity module to read through
  /// them: BRD §5.1 gives public profiles to Profiles & Trust, and
  /// `include: { profile: true }` from inside `identity/` is exactly the
  /// cross-module read that boundary exists to prevent. The profiles module
  /// reaches its own rows through its own port.
  profile Profile?
  address Address?

  /// Audit entries this account was the actor of. Same caveat as above — the
  /// relation exists because Prisma requires both ends declared, not so that
  /// another module can read the log through a user.
  auditEntries AuditLog[]

  /// The three sides of an administrative approval this account took part in.
  ///
  /// Three named relations because Prisma cannot tell them apart otherwise, not
  /// because anything reads an approval through a user. The distinction that
  /// matters is enforced in the database rather than here: a CHECK constraint
  /// stops `approvedById` ever equalling `proposedById`.
  proposedApprovals  AdminApproval[] @relation("ProposedApprovals")
  grantedApprovals   AdminApproval[] @relation("GrantedApprovals")
  cancelledApprovals AdminApproval[] @relation("CancelledApprovals")

  /// Sign-ins and sign-outs on this account. Declared because Prisma requires
  /// both ends of a relation; nothing reads authentication events through a
  /// user, and the identity module reaches them through its own port.
  authenticationEvents AuthenticationEvent[]

  /// Category configurations this account authored. BRD §6.2 puts an author on
  /// every category version, and this is that reference. Declared because
  /// Prisma requires both ends; the Catalogue module reaches versions through
  /// its own port and never through a user.
  authoredCategoryVersions CategoryVersion[]

  /// Present and inactive — see `SellerTaxProfile`. Optional because no seller
  /// has one and none can until a category is flagged reportable (§8.14.2).
  sellerTaxProfile SellerTaxProfile?

  /// What this person has put up for rent. `ON DELETE RESTRICT` — see `Listing`.
  listings Listing[]

  @@map("users")
}

/// A person's public face, and the contact details behind it.
///
/// A separate table rather than columns on `users`, because BRD §5.1 draws the
/// boundary there: Identity & Access owns accounts, roles and sessions, and
/// Profiles & Trust owns public profiles. Two modules writing one table is the
/// cross-module write CLAUDE.md bans, and it would be unavoidable if the
/// display name lived beside `role` and `deletedAt`.
///
/// **Only `displayName` is public.** BRD §6.2 calls this the "public and
/// contact profile" — one row, two audiences — so the split is enforced by the
/// projection the API returns, not by which table a column sits in. ADR 0016
/// records the rule: a stranger sees a name and a postal district, and contact
/// details are released only once a booking authorises it, the same way BRD
/// §8.4.1 gates a listing's true coordinates.
model Profile {
  id String @id @default(uuid()) @db.Uuid

  /// One profile per account. Unique because the alternative — two profiles for
  /// one user — makes "what is this person called" a question with two answers,
  /// and the loser is whichever row a query happens to sort first.
  ///
  /// `onDelete: Restrict` is the Prisma default for a required relation and is
  /// correct here: accounts are soft-deleted (see `User.deletedAt`), so a hard
  /// delete reaching this constraint means something is doing what the identity
  /// module deliberately does not. Failing is the right answer to that. Erasing
  /// a profile as part of a real deletion request is a later, deliberate slice.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// What other users see. NOT NULL because the row is created by the first
  /// save rather than provisioned empty — there is no state in which a profile
  /// exists without a name, so nothing downstream has to handle one.
  ///
  /// Deliberately **not** unique. Uniqueness would invite name squatting and a
  /// registration race, and it does not solve impersonation anyway: "Support"
  /// and "Support " are different strings. Impersonation is a Trust & Safety
  /// question for a later phase, not a constraint this column can answer.
  displayName String @db.Text

  /// Contact number, in E.164. **Never returned by a public endpoint.**
  ///
  /// Nullable because BRD §8.1 requires a verified phone before *listing or
  /// booking*, not before having a profile — demanding one at sign-up would
  /// block someone who only wants to browse.
  ///
  /// Stored in clear rather than encrypted, unlike the address detail. It is
  /// the same sensitivity class as `users.email`, which must be readable for
  /// citext uniqueness, and encrypting it would defeat the duplicate-number
  /// check that Trust & Safety needs against multi-account fraud. The
  /// protection here is that no projection exposes it, and that is tested.
  ///
  /// **Unverified.** Nothing has proved this number belongs to this person yet;
  /// verification needs Twilio (Phase 6) or a Clerk phone flow. Until then it
  /// must not be treated as a trust signal.
  phone String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

/// A postal address, split by how far each part may travel.
///
/// Its own table rather than columns on `profiles` for three reasons: BRD §6.2
/// models it as its own entity; the sensitivity differs sharply from a display
/// name; and Phase 3 adds a `geography(Point,4326)` column and a GiST index
/// here (BRD §4.2), which has no business on the row every public profile view
/// reads.
///
/// The columns are deliberately graded, so that reading the wrong one is a
/// visible mistake rather than a silent leak:
///
///   outwardCode      public    a postal district, thousands of addresses
///   town             public    coarse, and what makes the district legible
///   postcode         private   full — needed to geocode, identifies ~15 homes
///   encryptedDetail  private   the street lines, and the actual front door
///
/// Coordinates and the §8.4.1 fuzz offset are **not here yet**. They arrive in
/// Phase 3 with the search that needs them; storing a precise point before
/// anything queries it would be personal data held for no current purpose,
/// against BRD §10.
model Address {
  id String @id @default(uuid()) @db.Uuid

  /// Related to the user rather than to the profile: `users.id` is the platform
  /// identity every foreign key points at (BRD §6), and an address outlives any
  /// particular view of a person.
  ///
  /// Unique for now — one home address each. Listing locations arrive in Phase
  /// 2 and may or may not reuse this table; that is a decision to make with the
  /// listing requirement in hand, not to pre-empt with a nullable discriminator
  /// nothing yet needs.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Full, normalised to `BS7 8AA` by the postcode primitive in @platform/core.
  /// Private: Phase 3 geocodes it, and a booking may release it, but no public
  /// projection selects it.
  postcode String @db.Text

  /// The publishable half, derived from `postcode` on save.
  ///
  /// **Stored rather than truncated at render time, and that is the point.** A
  /// public query selects a column that has never held the inward code, so it
  /// cannot leak one by someone forgetting a `.slice()`. Denormalised on
  /// purpose; the write path is the only place the two can diverge, and it
  /// derives one from the other.
  outwardCode String @db.Text

  /// Post town — "Bristol". Public, and coarse enough to stay public: it makes
  /// an outward code readable to a person judging whether an item is near them.
  town String @db.Text

  /// The street lines, as an AES-256-GCM envelope (BRD §6.2, "encrypted
  /// detail"). One ciphertext over a small JSON object rather than a column per
  /// line, so adding a line later needs no migration and the column count
  /// reveals nothing about what is stored.
  ///
  /// Encrypted because these lines are the difference between "somebody in BS7"
  /// and a specific front door, and nothing operational needs them queryable —
  /// they are read back to show a person their own address, or released to a
  /// counterparty once a booking authorises it. A stolen dump then yields
  /// postal districts instead of addresses.
  encryptedDetail String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("addresses")
}

/// One received provider webhook, recorded so it is processed exactly once.
///
/// CLAUDE.md requires webhook events to be persisted entities rather than
/// in-memory deduplication. In-memory is wrong twice over: it forgets on
/// restart, and it is per-instance, so two API containers each process the
/// same delivery. Providers retry aggressively and Clerk is no exception.
///
/// **No payload column, deliberately.** Idempotency needs only the identifier;
/// the body carries email addresses and names we would then be storing a second
/// time, outside `users`, with no purpose and no retention rule — against the
/// data-minimisation requirement in BRD §10. Clerk retains the event and can
/// redeliver it, so replay does not depend on us keeping a copy.
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  /// `clerk` today. Named rather than assumed, because Stripe arrives in
  /// Phase 5 and two providers will eventually collide on event id.
  provider String @db.Text

  /// The provider's own delivery identifier — Clerk sends Standard Webhooks
  /// headers, so this is `svix-id`. Unique per delivery, stable across retries,
  /// which is exactly what makes it usable as the idempotency key.
  externalId String @db.Text

  eventType String @db.Text

  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Null while in flight. A row that stays null is a delivery we accepted and
  /// failed to apply — the thing worth alerting on once we have somewhere to
  /// send alerts.
  processedAt DateTime? @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@map("webhook_events")
}

/// One security-relevant thing that happened, recorded so it cannot be denied.
///
/// **Append-only.** BRD §17's risk table calls for immutable audit logs, and the
/// port above this table offers no update and no delete — the same discipline
/// the ledger will have. A log that can be edited by the code it audits is a
/// log that proves nothing about that code.
///
/// **It records that a value changed, never what it changed to** (BRD §6.2,
/// "before/after hash"). Storing the values would make this table a second,
/// longer-lived copy of exactly the personal data the rest of the system is
/// careful about — retained six years while the original is erasable, which
/// inverts the retention rules in §10.1. ADR 0017.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Who did it. Nullable for actions the system takes on nobody's behalf.
  ///
  /// A foreign key rather than a loose id, because an audit trail naming an
  /// actor that never existed is worse than no trail. Accounts are soft-deleted
  /// (see `User.deletedAt`), so this survives a deletion request — which is the
  /// point: §10.1 retains security logs for a year hot and six years cold, and
  /// erasing the evidence along with the account would defeat that.
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id])

  /// Dotted and past-tense — `profile.updated`, `account.provisioned`.
  ///
  /// A string rather than an enum: a Postgres enum needs a migration to add a
  /// value, so every new audited action in every future module would queue
  /// behind a schema change. The vocabulary is defined in the audit module and
  /// asserted there instead.
  action String @db.Text

  /// What it happened to. Deliberately not a foreign key: the target may be a
  /// profile, a listing or a booking, and a polymorphic reference cannot be
  /// constrained without a column per type. Integrity here is worth less than
  /// being able to audit anything.
  targetType String @db.Text
  targetId   String @db.Uuid

  /// HMAC-SHA256 of the canonical state before and after, keyed with a secret
  /// the database does not hold.
  ///
  /// Not a bare hash, though the BRD says "hash". A display name has a tiny
  /// value space, so an unkeyed digest is guessable offline by anybody holding
  /// this table — the protection would be theatre. Keyed, the digests still
  /// compare equal for equal inputs, which is all change-detection needs, and
  /// tell an attacker nothing. `beforeHash` is null for a creation.
  beforeHash String? @db.Text
  afterHash  String? @db.Text

  /// Why the actor did it.
  ///
  /// BRD §8.13: "Every admin action records actor, **reason**, target and
  /// before/after state." Nullable because an ordinary user action has no
  /// reason to give — somebody editing their own profile is not accountable to
  /// anyone for it — while an administrator reaching into another account is.
  /// The requirement is enforced where the distinction exists, in the admin
  /// routes, rather than by a NOT NULL that would force every user action to
  /// invent one (ADR 0021).
  reason String? @db.Text

  /// The client's address, as forwarded by the web app.
  ///
  /// Nullable because it genuinely is sometimes unknown: the API is not
  /// reachable from the internet, so it never sees a browser directly and this
  /// value is only as good as the hop that forwarded it. Recording the web
  /// container's own address instead would be misleading evidence in a security
  /// log, which is worse than an empty column. ADR 0017.
  ///
  /// `inet` rather than text so a malformed value is rejected by Postgres
  /// rather than stored and believed.
  ipAddress String? @db.Inet

  /// Which sign-in this happened in — Clerk's `sess_…`, from the `sid` claim.
  ///
  /// The join key to `AuthenticationEvent.clerkSessionId`, and named identically
  /// because it is the same value: a person's activity page can then say which
  /// sign-in an action belongs to instead of leaving them to match timestamps by
  /// eye. That is what BRD §8.1 wants the two records for — "signed in from an
  /// unrecognised device, and then changed the account email" is a sentence
  /// neither table can form alone.
  ///
  /// **Not a foreign key**, deliberately. A session event can be missed — the
  /// webhook races the account's first request (ADR 0025) — and an audit write
  /// is fail-closed, so a constraint here would turn a dropped delivery into a
  /// failed user action. The reference is advisory; an unmatched id simply shows
  /// no device, which is what the page already does for a sign-in it never saw.
  ///
  /// **Not indexed.** Nothing queries by it: the activity page fetches both
  /// lists for its own reasons and correlates them in memory. An index for a
  /// query nobody runs is write cost with no read.
  ///
  /// Nullable for actions no session is behind — a provider webhook, a
  /// system-initiated change — and for every row written before this column
  /// existed. Text rather than uuid: Clerk's ids are prefixed strings, not
  /// UUIDs, which is why `AuthenticationEvent` stores them the same way.
  ///
  /// Survives erasure, exactly as `ipAddress` above does. §10.1 retains these
  /// rows for six years and the identifier is less revealing than the address
  /// beside it; the sign-in row it points at is redacted, so the device and
  /// place are gone either way (ADR 0025).
  clerkSessionId String? @db.Text

  /// Stored UTC. No `updatedAt`, because nothing updates.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Serves the one query that exists: "what happened on my account, newest
  /// first". Composite rather than two indexes — a scan of every entry an actor
  /// ever made, sorted afterwards, is the shape that gets slow first.
  @@index([actorId, createdAt(sort: Desc)])

  /// The mirror of the above, for "what did somebody else do to my account".
  ///
  /// A person's activity page merges both directions, so every page load runs
  /// this query too. Without it the target side is a sequential scan of the
  /// whole table — and this table only ever grows, because nothing deletes from
  /// it and §10.1 retains security logs for six years.
  @@index([targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// An administrative action that needs a second administrator to agree.
///
/// BRD §8.13: "High-risk actions require step-up authentication and, for
/// selected actions, dual approval." §17 names dual approval as a mitigation
/// for admin misuse, beside least privilege, MFA and immutable audit logs.
///
/// **The two-person rule is a CHECK constraint, not only a service check.** The
/// same reasoning as the booking overlap constraint (ADR 0004): a rule that
/// exists only in application code is a rule the next code path forgets. Here
/// the cost of forgetting is one administrator granting themselves whatever
/// they like, so the database refuses it independently of anything above it.
///
/// Rows are never deleted. A refused or expired proposal is part of the record
/// of what administrators tried to do, which is most of the point.
model AdminApproval {
  id String @id @default(uuid()) @db.Uuid

  /// What is being proposed — `role.changed` today.
  ///
  /// Text with a closed union in code, for the reason `AuditLog.action` is:
  /// a Postgres enum would put every future approvable action behind a schema
  /// migration.
  action String @db.Text

  /// What it would happen to. `targetType` is text for the same polymorphic
  /// reason the audit log's is; today it is always `user`.
  targetType String @db.Text
  targetId   String @db.Uuid

  /// The parameters of the proposed change — `{"role":"ADMIN"}` today.
  ///
  /// JSON rather than a column per action, because the alternative is a table
  /// that grows a nullable column every time an action is added and where no
  /// row ever uses more than one of them. The shape is validated in code
  /// against the closed action union before it is written.
  payload Json @db.JsonB

  proposedById   String   @db.Uuid
  proposedBy     User     @relation("ProposedApprovals", fields: [proposedById], references: [id])
  /// Why. Mandatory here, unlike `AuditLog.reason` — every row in this table is
  /// an administrative action, so there is no ordinary user action to burden.
  proposedReason String   @db.Text
  proposedAt     DateTime @default(now()) @db.Timestamptz(3)

  /// When the proposal stops being approvable.
  ///
  /// A window rather than an indefinite queue: an approval sitting for a month
  /// is approved against circumstances nobody remembers, and a stale queue is
  /// one people rubber-stamp to clear.
  expiresAt DateTime @db.Timestamptz(3)

  /// Set together, in one transaction with the effect itself.
  ///
  /// There is deliberately no separate "executed" timestamp. Approval *is* the
  /// execution — a window in which a decision is recorded but not applied is a
  /// window somebody has to reconcile, and this way a failure to apply rolls
  /// the approval back and leaves the proposal pending and retryable.
  approvedById   String?   @db.Uuid
  approvedBy     User?     @relation("GrantedApprovals", fields: [approvedById], references: [id])
  approvedReason String?   @db.Text
  approvedAt     DateTime? @db.Timestamptz(3)

  cancelledById   String?   @db.Uuid
  cancelledBy     User?     @relation("CancelledApprovals", fields: [cancelledById], references: [id])
  cancelledReason String?   @db.Text
  cancelledAt     DateTime? @db.Timestamptz(3)

  /// Serves the one query: the pending queue, newest first.
  @@index([proposedAt(sort: Desc)])
  @@map("admin_approvals")
}

/// A sign-in, or the end of one.
///
/// BRD §8.1 asks for "authentication events, device/session management and
/// suspicious-login alerts". This is the first of the three: the record a
/// person reads to answer "has anybody else been in my account".
///
/// **A separate table rather than more `audit_logs` rows, and the reason is the
/// shape.** Every other audited action is something somebody chose to do, and
/// `audit_logs` stores digests rather than values precisely so it can be
/// retained for six years without holding personal data (ADR 0017). An
/// authentication event is the opposite on both counts: it is not a deliberate
/// act, and it is worthless unless it holds the very values a digest would
/// destroy — a person cannot recognise an intruder from an HMAC. Widening
/// `AuditEntry` with seven columns that twenty-five other actions leave null is
/// the optional-field anti-pattern ADR 0016 rejected for profiles.
///
/// Volume differs too. One row per sign-in against one per deliberate action,
/// and nothing prunes either — see the retention note on `occurredAt`.
///
/// The person still reads one merged history: their activity page joins this
/// with both directions of the audit trail.
model AuthenticationEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Whose account. Required, unlike the audit log's actor — an authentication
  /// event with no account is not a degraded record, it is meaningless.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation, and it is
  /// the right one: accounts are soft-deleted (see `User.deletedAt`) so this
  /// never fires in production. It fires in tests, where clearing `users`
  /// without clearing this first now fails — children before parents.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Clerk's `sess_…`, the session this event is about.
  ///
  /// A reference to the provider's record, never an identity of ours — the same
  /// rule `clerkUserId` follows. Kept because it is what lets a person match a
  /// row here against a device in Clerk's own session list, and what a support
  /// enquiry cites.
  clerkSessionId String @db.Text

  /// `started`, `ended`, `removed` or `revoked`.
  ///
  /// Our vocabulary, not Clerk's four `session.*` event names, because the
  /// mapper's job is to stop provider shape at the boundary. Text rather than a
  /// Postgres enum for the reason `AuditLog.action` gives: an enum puts every
  /// new value behind a schema migration.
  event String @db.Text

  /// When it happened **at Clerk**, not when we stored it.
  ///
  /// Webhooks are asynchronous and can be redelivered hours later, so the two
  /// genuinely differ and only this one answers "when was I signed in". Stored
  /// UTC and rendered in the viewer's zone, per BRD §6.1.
  ///
  /// **Nothing prunes this table.** §10.1 retains security logs six years and
  /// no scheduler exists yet, so rows accumulate per sign-in indefinitely. That
  /// is a known limitation recorded in the handoff rather than a design intent.
  occurredAt DateTime @db.Timestamptz(3)

  /// Where the sign-in came from, as Clerk's geo-location resolved it.
  ///
  /// **Every one of these is nullable, and that is Clerk's shape rather than
  /// caution.** `latest_activity` is optional on the session payload, and each
  /// field within it is optional again apart from `is_mobile`. A correctly
  /// delivered event can carry none of them, and inventing a value to fill a
  /// column would put a guess in a security record.
  ///
  /// `inet` rather than text so Postgres rejects a malformed address instead of
  /// storing it — and note real values here are frequently IPv6, which `inet`
  /// holds and a `varchar(15)` would have silently truncated.
  ipAddress      String?  @db.Inet
  browserName    String?  @db.Text
  browserVersion String?  @db.Text
  deviceType     String?  @db.Text
  isMobile       Boolean?

  /// Stored UTC. No `updatedAt`: like the audit log, nothing updates a row
  /// here. Erasure is the one exception and it nulls columns rather than
  /// rewriting history — see the eraser.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One row per event per session.
  ///
  /// Idempotency already comes from the `webhook_events` ledger, which refuses
  /// a redelivered *delivery*. This guards the case that ledger cannot see: the
  /// same logical event arriving under two delivery ids. The recorder treats a
  /// conflict as already-done rather than an error, because a webhook handler
  /// that 500s on a duplicate is one Clerk retries forever.
  @@unique([clerkSessionId, event])

  /// Serves the only query: this account's sign-ins, newest first, for the
  /// activity page and the data export.
  @@index([userId, occurredAt(sort: Desc)])
  @@map("authentication_events")
}

/// A rental category — the unit of configuration the whole engine turns on.
///
/// BRD §1.2 makes the platform category-agnostic: categories, fees, attributes,
/// radii, deposits and policies are versioned configuration and never code. This
/// table is the identity half of that. It holds only what never changes about a
/// category — which is, deliberately, almost nothing.
///
/// **Everything configurable lives on `CategoryVersion`, not here.** A column
/// here would be a fact with no version attached, and §8.2 requires that
/// "existing bookings retain the configuration version under which they were
/// created". A booking cannot pin a value that is stored where it can be
/// overwritten.
model Category {
  id String @id @default(uuid()) @db.Uuid

  /// Stable public identity: the URL segment, and the SEO slug §8.17 needs to
  /// keep canonical. Immutable by convention rather than by constraint — the
  /// display name is what an administrator renames, and renaming that mints a
  /// version while the slug stays put so links do not rot.
  slug String @unique @db.Text

  versions CategoryVersion[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("categories")
}

/// One immutable snapshot of a category's configuration.
///
/// **The current configuration is the highest `versionNumber` for the category.**
/// There is deliberately no `currentVersionId` pointer on `Category`: that would
/// be a cycle between two required foreign keys, which Postgres will only insert
/// into with deferred constraints and which Prisma models badly — and it would
/// introduce a second source of truth that can disagree with the rows. The
/// unique constraint below makes "highest" unambiguous, and a btree scans
/// backwards, so finding it costs an index seek.
///
/// **Rows are never updated.** A trigger enforces it rather than trusting the
/// port, because the port is the thing somebody edits when they need to
/// "correct" a value. `UPDATE` is refused; `DELETE` is not, so test teardown and
/// a future category removal both remain possible — and from Phase 4 a booking's
/// foreign key is what will actually hold a referenced version in place.
model CategoryVersion {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Monotonic per category, starting at 1. The unique constraint below is what
  /// makes concurrent edits safe: two administrators saving at once produce the
  /// same next number, and the second insert fails rather than silently winning.
  versionNumber Int

  /// What an administrator sees and renames. Not the slug — see `Category.slug`.
  name String @db.Text

  /// How much care this category's items demand, which later drives deposit
  /// bands, verification and prohibited items (§8.2).
  ///
  /// Text with a closed union in code, exactly as `AuditLog.action` and
  /// `AdminApproval.action` are, so adding a level is not a schema migration.
  /// The *set* of levels is domain vocabulary; the *assignment* to a category is
  /// configuration, which is the distinction CLAUDE.md's rule is drawing.
  riskLevel String @db.Text

  /// The category's attribute schema, in render order (ADR 0027, BRD §8.2).
  ///
  /// A closed vocabulary of four types — `text`, `number`, `choice` and
  /// `choice-many` — validated by `categoryAttributesSchema` in
  /// @platform/contracts, which is the only thing that may write here. Postgres
  /// checks that the value is JSON; it does not and cannot check that it is a
  /// schema this build can render, so the adapter parses on the way out.
  ///
  /// **JSON rather than a child table, deliberately.** This row is immutable by
  /// the trigger below, and a JSON column inherits that guarantee; rows in a
  /// child table would not, and one appended against last month's version would
  /// silently change the terms of every booking pinned to it. The schema is also
  /// always read whole, never queried attribute by attribute, and its order is
  /// meaningful — which a relational table would need a position column to keep.
  ///
  /// Defaults to an empty schema, which is exactly what a category configured
  /// before slice 2.2 has. No backfill invents a schema nobody chose.
  attributes Json @default("[]") @db.JsonB

  /// Which transport requirements this category offers a listing, and the weight
  /// each one is suggested up to (BRD §8.3, ADR 0031, slice 2.4c).
  ///
  /// **A selection from a closed platform vocabulary, not a per-category option
  /// list.** §8.3 requires the requirement to reach the booking summary, the
  /// collection instructions, the handover checklist and a search filter — four
  /// consumers that must be able to ask any listing what it needs. If each
  /// category spelled its own options, `van` here and `van_required` there would
  /// be two different filters with nothing to notice. The vocabulary lives in
  /// @platform/contracts and adding a value to it is a deploy.
  ///
  /// **On the version rather than on `Category`**, with the rest of the
  /// configuration and for the same reason: §8.2 requires a booking to be
  /// interpreted under the configuration in force when it was made, and a
  /// listing pins this row. Withdrawing an option must not change what an
  /// existing listing claims about itself.
  ///
  /// Stored in the vocabulary's display order, which the contract normalises on
  /// the way in — so two administrators ticking the same boxes in a different
  /// order produce the same value, and the audit digest does not report a change
  /// nobody made.
  ///
  /// Defaults to an empty selection, which is what every category configured
  /// before this migration has. No backfill invents a selection nobody chose;
  /// such a category simply asks nothing about transport until it is
  /// reconfigured.
  transportOptions Json @default("[]") @db.JsonB

  /// Which statutory reporting head this category's activity falls under
  /// (§8.14.2). `none`, `means_of_transport`, `personal_service` or
  /// `sale_of_goods`, as a closed union in code exactly like `riskLevel`.
  ///
  /// **On the version rather than on `Category`, and that is not a detail.**
  /// This is the one configuration value that can change the platform's
  /// regulatory status, and §8.2 requires a booking to be interpreted under the
  /// configuration in force when it was made. A flag stored on the category
  /// would answer "is this reportable now"; a report has to answer "was this
  /// reportable when it happened".
  ///
  /// Defaults to `none`, which is true rather than merely convenient: §8.14.1
  /// determined that rental of general goods is not a Relevant Activity, so
  /// every category configured before this migration was correctly outside
  /// scope.
  reportableActivity String @default("none") @db.Text

  /// What the platform charges on a booking in this category (BRD §8.2, §3.4,
  /// slice 2.7a).
  ///
  /// **Scalar columns, not the `Json` treatment `attributes` gets**, and the
  /// difference is the shape rather than the taste. An attribute schema is
  /// variable-length, ordered, and always read whole; a fee policy is four fixed
  /// values that later phases query *across* categories — §3.4.3's worked
  /// example, Phase 5's payout reconciliation and any "which categories charge
  /// more than X" question all want columns rather than a blob every row has to
  /// be parsed to answer.
  ///
  /// **On the version, and that is the whole reason this row exists.** §8.2
  /// requires a booking to be interpreted under the configuration in force when
  /// it was made. A rate on `Category` answers "what do we charge now"; a payout
  /// dispute eighteen months later needs "what did we charge then", and only an
  /// immutable row can answer that.
  ///
  /// Rates are **basis points** — hundredths of a percent, 15% is `1500`.
  /// Integer for ADR 0002's reason applied one step early: a rate is not money,
  /// but it is what money gets multiplied by, so a float here reaches the ledger
  /// just as surely. See `MAX_FEE_BASIS_POINTS` in @platform/contracts.
  ///
  /// Both default to zero, which is what every category configured before this
  /// migration has. **No backfill invents a fee nobody agreed to** — the same
  /// call the attribute schema and the transport options each made. Zero is safe
  /// where a guess is not, because §8.2 already forbids enabling a category for
  /// public booking before §3.4.3's worked example exists.
  ownerCommissionBasisPoints Int @default(0) @db.Integer
  renterFeeBasisPoints       Int @default(0) @db.Integer

  /// The booking total below which a booking may not be submitted (§3.4.2), and
  /// the floor under the platform fee when the percentage falls below it.
  ///
  /// Integer minor units plus the currency on the same record, exactly as
  /// `Listing.replacementValue*` (ADR 0002). The floors are configuration here;
  /// the *booking* minimum is enforced in Phase 4, where a booking exists to
  /// refuse. The **fee** floor is pricing logic and applies from 2.7b: 8% of a
  /// £6 day is 48p, which does not cover the card processing on it.
  minimumBookingTotalAmount   Int    @default(0) @db.Integer
  minimumBookingTotalCurrency String @default("GBP") @db.Text
  minimumPlatformFeeAmount    Int    @default(0) @db.Integer
  minimumPlatformFeeCurrency  String @default("GBP") @db.Text

  /// Who made this configuration what it is. BRD §6.2 puts an author on the
  /// entity; the corresponding audit entry carries the reason and the digests.
  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listings Listing[]

  /// Both the "no two versions share a number" rule and the index that answers
  /// "what is current". One constraint, two jobs, no second index to maintain.
  @@unique([categoryId, versionNumber])

  /// Redundant on its own — `id` is already unique — and it exists to be the
  /// target of a composite foreign key from `listings`.
  ///
  /// A listing stores both the category and the pinned version (BRD §6.2 names
  /// both). Storing them as two independent foreign keys would allow a row
  /// claiming category A and a version belonging to category B, which is the
  /// second-source-of-truth problem slice 2.1 refused for `currentVersionId` —
  /// except here nothing would ever notice. Referencing this pair instead makes
  /// the disagreement unrepresentable rather than merely unlikely.
  @@unique([id, categoryId])
  @@map("category_versions")
}

/// A rentable item, as its owner describes it (BRD §8.3, §6.2).
///
/// **The first row a user creates rather than an administrator**, which is why
/// ownership is a column here rather than an assumption anywhere else. Every
/// read of this table is scoped by `ownerId` until slice 2.10 publishes a public
/// projection.
///
/// A draft is deliberately allowed to be incomplete. §8.3 says owners "create
/// draft listings and save progress", so most of what a listing eventually needs
/// — location, prices, media, availability, rules — is absent here and arrives
/// in 2.5 through 2.8. Completeness is a publication rule, not a storage rule.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  /// Whose item it is.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation. It never
  /// fires in production because accounts are soft-deleted, and that is the
  /// point: a listing must not vanish from a booking's history because its owner
  /// closed their account.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  /// The category, and the exact configuration version this listing was written
  /// against — BRD §6.2 puts both on the entity.
  ///
  /// **One composite foreign key, not two separate ones.** `(categoryVersionId,
  /// categoryId)` references the matching unique pair on `category_versions`, so
  /// a listing cannot claim one category while pinning a version belonging to
  /// another. Two independent keys would each be individually valid in exactly
  /// that broken state.
  ///
  /// The pin is what makes the attribute values in slice 2.4b mean something: it
  /// records which schema they were entered and validated against, so
  /// reconfiguring a category cannot retroactively invalidate a listing.
  categoryId        String          @db.Uuid
  categoryVersionId String          @db.Uuid
  categoryVersion   CategoryVersion @relation(fields: [categoryVersionId, categoryId], references: [id, categoryId])

  title       String @db.Text
  /// May be empty on a draft, and that is a real value rather than a missing
  /// one — §8.3's "save progress". Publication requires prose (2.8).
  description String @db.Text

  /// The answers to this category's attributes, keyed by attribute key
  /// (ADR 0027, BRD §8.2, slice 2.4b).
  ///
  /// **An object, where the definitions are an array.** The definitions carry
  /// render order and this does not need to: the schema on the pinned version is
  /// the ordering authority, and a second one here could disagree with it.
  ///
  /// **Only the keys that were answered are present.** An unanswered attribute
  /// is absent rather than null, so the platform has one representation of "not
  /// answered" instead of two that every later reader must remember to treat
  /// alike. `required` is not enforced on a draft — §8.3 says owners save
  /// progress, and completeness is a publication rule (2.8).
  ///
  /// Validated by `validateAttributeValues` in @platform/contracts **against the
  /// schema on the version this row pins**, never against the category's current
  /// one. That is what stops a reconfiguration retroactively invalidating a
  /// listing, and it is why renaming an attribute key cannot orphan a stored
  /// value: the rename mints a new version, and this row still points at the old
  /// one, whose schema still has the old key.
  ///
  /// Postgres checks only that the value is JSON. It cannot check that the keys
  /// match a schema it would have to read from another row, so the adapter is
  /// where that holds.
  attributes  Json   @default("{}") @db.JsonB

  /// What replacing the item would cost, as integer minor units plus the
  /// currency, on the same record (ADR 0002, CLAUDE.md).
  ///
  /// **The first money stored anywhere in this system.** §8.7.1 derives the
  /// damage excess from it — "the greater of a fixed floor or a percentage of
  /// replacement value" — so this number becomes an amount held on somebody's
  /// card. `Int` rather than `Decimal` or `Float`: pence are whole, and a float
  /// here would be a rounding error with a legal consequence.
  ///
  /// The currency is stored rather than assumed. Today there is one; the day
  /// there are two, every bare number becomes ambiguous with nothing to
  /// disambiguate it.
  replacementValueAmount   Int    @db.Integer
  replacementValueCurrency String @db.Text

  /// What it costs to rent (BRD §8.5.2, §8.3, slice 2.7b).
  ///
  /// Integer minor units plus the currency on the same record (ADR 0002), the
  /// same shape `replacementValue` above uses.
  ///
  /// **All nullable, because §8.3 makes a draft permissive** — an owner saves
  /// progress and completeness is a publication rule. **Slice 2.8 must refuse to
  /// publish a listing with no daily rate**, for the reason it must refuse one
  /// with no coordinates: it would be a listing nothing can price and nobody can
  /// book, which is a legitimate draft and an illegitimate published listing.
  ///
  /// **The daily rate is the spine.** The other two are alternatives to it, not
  /// replacements — a `CHECK` refuses a weekend or weekly rate with no daily one
  /// beside it, because such a row describes an item rentable for three days but
  /// not one, with nothing saying so.
  ///
  /// **There is no hourly rate**, though §8.5.2 names one. In a peer-to-peer
  /// model the renter drives to a stranger's house to collect, so the round trip
  /// exceeds the rental, and nothing in the launch category is hired by the
  /// hour. An unused rate is a case every consumer from the quote engine to the
  /// handover checklist carries forever. A column away if a later category wants
  /// it. Configurable discounts are absent for a different reason: a discount
  /// applies to a duration, and Phase 2 has no dates.
  ///
  /// One currency column serves all three. Two rates on one listing in different
  /// currencies is not a state anything downstream could price, and §6.1's rule
  /// is that the code travels with the amount — which it does, for the record as
  /// a whole.
  dailyRateAmount   Int?   @db.Integer
  weekendRateAmount Int?   @db.Integer
  weeklyRateAmount  Int?   @db.Integer
  rateCurrency      String @default("GBP") @db.Text

  /// What is needed to collect and carry this item (BRD §8.3, ADR 0031,
  /// slice 2.4c-ii).
  ///
  /// One of the platform's closed vocabulary — `hand_carryable`, `car_boot`,
  /// `estate_or_hatchback`, `van_required`, `trailer_required` — as text with
  /// the union in code, exactly like `status` and `riskLevel`. **Which of them
  /// are legal for this listing is category configuration**, held on the version
  /// this row pins, so no CHECK constraint here could express it without reading
  /// another table's JSON. The service validates against the pinned options and
  /// the adapter refuses a value this build does not know.
  ///
  /// **Nullable, because a draft has not necessarily said yet.** §8.3 lets
  /// owners save progress, so completeness is a publication rule (2.8) — which
  /// inherits the question of what publishing means for a category that offers
  /// no options at all.
  transportRequirement String? @db.Text

  /// Whether it takes two people to lift.
  ///
  /// **A separate column, not a value in the vocabulary above** (ADR 0031). The
  /// BRD's example list puts "two-person lift" beside the vehicle sizes, but an
  /// item can need a van *and* two people, and one column would force an owner
  /// to discard one of two true facts.
  ///
  /// Not nullable and defaulted false: unlike the requirement, this has a
  /// meaningful answer for an item nobody has thought about yet, and "we do not
  /// know" and "no" would be two states every later reader has to treat alike.
  /// It feeds §8.9's handover checklist regardless of what the category
  /// configured, which is why it is asked of every listing.
  requiresTwoPersonLift Boolean @default(false)

  /// The **publishable** half of where this item is collected from (§8.4.1,
  /// slice 2.5a). `BS7` and `Bristol`.
  ///
  /// **On the listing, while the precise half lives in `listing_locations`.**
  /// The split is the disclosure rule made structural. A listing row is public
  /// content — 2.10 renders it, Phase 3 searches it, and both will select it
  /// broadly — so a full postcode stored here would be personal data on a row
  /// whose whole purpose is to be shown to strangers, protected only by every
  /// future author remembering a `select`. Instead the private half is a
  /// different table nobody joins by accident, and these two columns have never
  /// held anything finer than a postal district covering thousands of homes.
  ///
  /// **Derived on write from the stored postcode**, in one place, exactly as
  /// `addresses.outwardCode` is. That is the only place the two can diverge.
  ///
  /// Both null together or both set together — a `CHECK` enforces it below.
  /// Nullable at all because a draft legitimately has not said where the item
  /// lives (§8.3); publication is where that becomes required (2.8).
  ///
  /// **They survive erasure**, deliberately. Deleting an account removes the
  /// `listing_locations` row and leaves these, so the listing collapses to the
  /// coarseness it was always published at rather than losing coherence — a
  /// listing that must outlive its owner for booking history, and a district
  /// that identifies nobody.
  outwardCode String? @db.Text
  town        String? @db.Text

  location ListingLocation?

  /// `DRAFT`, and nothing else until slice 2.8 brings the rest of the lifecycle.
  ///
  /// Text with a closed union in code, exactly as `riskLevel` and
  /// `reportableActivity` are. Present now rather than later because
  /// retrofitting a status onto rows that bookings already reference is a
  /// migration nobody wants, and because a listing with no status is
  /// indistinguishable from one that is live.
  status String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// The only query this slice makes: this owner's listings, newest first. The
  /// owner dashboard (2.9) wants the same order.
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("listings")
}

/// Where a listing actually is — **the half that is never published**.
///
/// A table of its own rather than more columns on `listings`, for three reasons
/// that all point the same way (slice 2.5a).
///
/// **Disclosure.** A listing is public content and this is not. Separating them
/// means the public projection in 2.10 and the search in Phase 3 do not join
/// this table at all, rather than joining it and remembering to exclude columns.
/// A `select` can be forgotten; a join that was never written cannot.
///
/// **Erasure.** Removing everything precise about where somebody lives is one
/// row delete, and "erased" is then unambiguous. The alternative — nulling four
/// columns on a row that must survive — leaves the question of whether a null
/// means erased or never-supplied, on the one table where that distinction is
/// answered years later by a regulator.
///
/// **Slice 2.5b.** The coordinates, the persisted fuzz offset and the
/// `Unsupported("geography(Point,4326)")` column BRD §4.2 requires all belong
/// with the postcode they are derived from. Putting an `Unsupported` column on
/// `listings` would put a raw-SQL-only concern on the central model of this
/// entire phase; here it stays where the raw SQL is meant to be confined.
///
/// **There are no coordinates here yet**, and that is 2.5a's boundary. This
/// slice captures the address and publishes the district; 2.5b geocodes it and
/// displaces it.
model ListingLocation {
  /// The listing itself is the identity — one location per listing, and the
  /// listing id *is* the primary key rather than a surrogate beside a unique
  /// constraint. A second key would allow two rows to exist long enough for
  /// something to read the wrong one.
  listingId String  @id @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// The full postcode, normalised to `BS7 8AA` — **in clear, deliberately.**
  ///
  /// The same decision `addresses.postcode` records, and the same reason: slice
  /// 2.5b geocodes this column, and encrypting a value the geocoder needs would
  /// mean decrypting every row to answer "what is near me". It is the most
  /// sensitive column in this table — about fifteen households, often one
  /// building — and it is protected by living in a table no public query joins,
  /// not by a cipher.
  postcode String @db.Text

  /// The street lines, as an AES-256-GCM envelope, exactly as `addresses` holds
  /// them (ADR 0016).
  ///
  /// One ciphertext over a small JSON object rather than a column per line, so
  /// adding a line later needs no migration and the column count reveals nothing
  /// about what is stored. The **listing id** is bound in as additional
  /// authenticated data, so an envelope copied onto another listing's row fails
  /// to decrypt rather than being served as that listing's address.
  encryptedDetail String @db.Text

  /// Where the postcode actually is (slice 2.5b).
  ///
  /// **Floats, and that is correct — ADR 0002 is about money.** Pence are whole
  /// and a rounding error there is somebody's money; a coordinate is a
  /// continuous quantity with no natural unit, and the nearest whole degree is
  /// 111 km wide. Do not "fix" these into integers on the strength of the money
  /// rule.
  ///
  /// **Nullable, because geocoding depends on a third party.** It can be down,
  /// and it can simply not recognise a valid new postcode — its data is a
  /// snapshot. §8.3 makes a draft permissive, so neither may stop somebody
  /// saving one: the listing keeps its address and reads as "not located yet".
  /// **Slice 2.8 must refuse to publish a listing with no coordinates**, because
  /// a published listing no search can find is worse than a draft.
  ///
  /// **Never returned by a public or pre-booking response** (§8.4.1). It exists
  /// for Phase 7, which hands the renter an exact place once a booking
  /// authorises collection — re-geocoding at handover would make two strangers
  /// meeting depend on a third party being up.
  latitude  Float? @db.DoublePrecision
  longitude Float? @db.DoublePrecision

  /// The persisted fuzz offset — BRD §8.4.1, ADR 0032.
  ///
  /// **Drawn once at random when the coordinates first exist, and never
  /// recomputed.** Recomputing per request leaks the true point through
  /// averaging. Not derived from the listing id either: a derived offset is
  /// invertible, so a leaked key would yield every owner's home address with no
  /// database access at all. Read ADR 0032 before changing any of this.
  ///
  /// Integers: a whole degree of bearing at 1 km is under 18 m, and metre
  /// precision on a deliberate blur is already far finer than the blur.
  fuzzBearingDegrees Int?
  fuzzDistanceMetres Int?

  /// The published point — the true one displaced by the offset above.
  ///
  /// **Stored rather than derived at read time**, and that is the same instinct
  /// as `addresses.outwardCode`: deriving makes the published location the
  /// output of a function somebody can change, and a different earth radius or
  /// rounding would silently move every listing. Storing makes it a fact.
  fuzzedLatitude  Float? @db.DoublePrecision
  fuzzedLongitude Float? @db.DoublePrecision

  /// The GiST-indexed geography for Phase 3's radius query — BRD §4.2.
  ///
  /// **Nullable, and that is load-bearing.** §4.2: *"A **required**
  /// `Unsupported` column blocks ordinary Prisma Client writes on that model."*
  /// Nullable, it does not, so this model stays fully writable through Prisma
  /// and only the radius query needs raw SQL.
  ///
  /// **Derived from the FUZZED point, by trigger, never written by application
  /// code.** On the fuzzed point because it exists to serve public radius
  /// queries and §8.4.1 permits those to touch nothing else — an index on the
  /// true point would be an index no public query may use. ADR 0032 makes that
  /// binding on Phase 3: filtering on the true coordinate would let an attacker
  /// binary-search the radius from three origins and recover the exact point,
  /// which is the trilateration attack §8.4.1 opens by describing.
  fuzzedPoint Unsupported("geography(Point,4326)")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Declared here as well as created in the migration, so the datamodel and the
  /// database agree.
  ///
  /// Without it `prisma migrate diff` reports drift — *"removed index on columns
  /// (fuzzedPoint)"* — because Prisma would generate a schema with no such index
  /// and conclude the database has one it should not. Harmless under
  /// `migrate deploy`, which is what the deploy runs, and **not** harmless under
  /// `migrate dev`, which would helpfully write a migration dropping the index
  /// BRD §4.2 requires.
  @@index([fuzzedPoint], type: Gist)
  @@map("listing_locations")
}

/// A seller's tax position for statutory reporting — **present and inactive**.
///
/// BRD §14 requires this entity from Phase 1 and §8.14.2 says why: *"the Seller
/// tax profile entity and the reporting export exist in the data model from the
/// outset but are inactive while all categories are flagged `none`. This keeps
/// the obligation a configuration switch, not a rebuild."*
///
/// **Nothing writes here, and no application code reads it.** There is no port,
/// no service and no route. That is the specified state, not an oversight: every
/// category is `none` (§8.14.1 — rental of general goods is not a Relevant
/// Activity), so there is no lawful basis to collect any of this and no
/// obligation to.
///
/// **It deliberately has no personal-data columns yet**, though §6.2 lists
/// "collected fields". Those fields are a name, an address, a date of birth and
/// a taxpayer reference — personal data, which in this codebase means a table
/// that `PersonalDataEraser` erases and the two `PersonalDataSource`
/// projections expose. Nothing enumerates the tables that hold personal data, so
/// a fourth one added now would silently be absent from erasure and from the
/// export, and would stay absent until somebody noticed. The columns arrive with
/// the collection flow that needs them, together with their erasure — expand and
/// contract, and the expand step waits for a reader.
///
/// **No module owns it.** BRD §5.1 names no owner, and it has no behaviour to
/// place. When it activates the likely home is Payments & Ledger, because what
/// gets reported is the consideration paid to a seller — but that is a decision
/// for the slice that builds collection, not one to guess at here.
model SellerTaxProfile {
  id String @id @default(uuid()) @db.Uuid

  /// One profile per seller. Keyed on the platform `users.id`, never on the
  /// identity provider's subject — ADR 0015's rule, and the reason this survives
  /// changing provider.
  ///
  /// `ON DELETE RESTRICT`, Prisma's default for a required relation, and the
  /// right one twice over: accounts are soft-deleted so it never fires, and a
  /// statutory record that a deletion could take with it would be the wrong
  /// shape for something retained against a filing deadline.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Which reporting regime applies — `uk_dprr` today, and nothing else.
  ///
  /// A regime rather than the reportable-activity head, because a seller can be
  /// active in two reportable categories at once and would then need two
  /// profiles under one obligation. The head lives on the category version,
  /// where it belongs; this says whose rules the resulting return is filed
  /// under, which is what §6.2 means by "applicable reporting regime".
  ///
  /// **No default.** One value exists today, so a default would be free — and it
  /// would mean the first code to write a row could do so without deciding
  /// anything, which is the failure ADR 0025 describes. A `CHECK` pins the
  /// vocabulary; see the migration.
  regime String @db.Text

  /// `not_started`, `pending`, `verified` or `failed` (§6.2, "verification
  /// state"). Also `CHECK`ed rather than left to code, because there is no code:
  /// until this activates, the constraint is the only thing that can refuse a
  /// value nobody meant.
  ///
  /// Provisional by design. Nothing has been built against it, and no row
  /// exists, so widening the vocabulary costs a migration on an empty table.
  verificationState String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("seller_tax_profiles")
}
