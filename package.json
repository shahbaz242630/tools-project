{
  "name": "rental-marketplace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project packages --project api --project worker --project scripts --project web",
    "test:watch": "vitest --project packages --project api --project worker --project scripts --project web",
    "test:coverage": "vitest run --project packages --project api --project worker --project scripts --project web --coverage",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && node scripts/verify-stack.mjs",
    "db:logs": "docker compose logs -f",
    "db:verify": "node scripts/verify-stack.mjs",
    "db:psql": "docker exec -it rental-postgres psql -U rental -d rental_dev",
    "licences:check": "node scripts/check-licences.mjs",
    "verify:runtime": "node scripts/verify-runtime-imports.mjs",
    "invariants": "node scripts/check-invariants.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs && pnpm --filter @platform/database generate",
    "db:generate": "pnpm --filter @platform/database generate",
    "db:migrate": "pnpm --filter @platform/database migrate",
    "db:migrate:deploy": "pnpm --filter @platform/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @platform/database migrate:status",
    "db:migrate:test": "pnpm --filter @platform/database migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "^4.1.2",
      "find-my-way@<9.7.0": ">=9.7.0",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
