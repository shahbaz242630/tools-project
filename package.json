{
  "name": "rental-marketplace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project packages --project api --project worker --project scripts",
    "test:watch": "vitest --project packages --project api --project worker --project scripts",
    "test:coverage": "vitest run --project packages --project api --project worker --project scripts --coverage",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && node scripts/verify-stack.mjs",
    "db:logs": "docker compose logs -f",
    "db:verify": "node scripts/verify-stack.mjs",
    "db:psql": "docker exec -it rental-postgres psql -U rental -d rental_dev",
    "licences:check": "node scripts/check-licences.mjs",
    "verify:runtime": "node scripts/verify-runtime-imports.mjs",
    "invariants": "node scripts/check-invariants.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "overrides": {
      "find-my-way@<9.7.0": ">=9.7.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
