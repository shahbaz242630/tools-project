# Copy to .env.local and adjust. Never commit .env.local — this repository is
# public and .gitignore blocks it, but the rule is: secrets live here and in the
# host secret manager, never in git.
#
# The values below are safe defaults for the local Docker stack only. They are
# deliberately obvious placeholders so a leaked local value is worthless.

# --- Local database ----------------------------------------------------------
POSTGRES_USER=rental
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=rental_dev
# 5433 rather than the default 5432, so this stack coexists with any other
# Postgres already running on the machine. Change freely — nothing hardcodes it.
POSTGRES_PORT=5433

# Application connection strings. rental_test is created by the init script and
# is the only database the integration suite may touch.
DATABASE_URL=postgresql://rental:local_dev_only@localhost:5433/rental_dev
TEST_DATABASE_URL=postgresql://rental:local_dev_only@localhost:5433/rental_test

# --- Local cache and queue ---------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
